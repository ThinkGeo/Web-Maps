@page "/vector-map-providers"
@using ThinkGeo.Core

<div class="map-container vector-map-providers-map" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@WorldCenter" Zoom="1" Bearing="0" Pitch="0">
            <OverlaysSetting>
                @if (styleUri == null)
                {
                    <ThinkGeoCloudVectorMapsOverlay Id="ThinkGeo" MapType="@mapType" ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                }
                else
                {
                    <VectorTileOverlay Id="Styled" StyleJson="@styleUri" />
                }
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@WorldCenter" CenterButtonZoom="1"
                                    CenterButtonBearing="0" CenterButtonPitch="0" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@WorldCenter" Zoom="1" Bearing="0" Pitch="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
    </div>
    <div style="width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;padding:8px;display:flex;flex-direction:column;background:dimgray;color:whitesmoke;font:13px system-ui;min-height:0">
        <div style="font-size:16px;font-weight:600;margin-bottom:6px">Vector maps from a service</div>
        <label style="display:block;margin:4px 0;cursor:pointer"><input type="radio" name="provider" checked="@(styleUri == null && mapType == ThinkGeoCloudVectorMapsMapType.Light)" @onchange="@(() => ShowThinkGeo(ThinkGeoCloudVectorMapsMapType.Light))" /> ThinkGeo Maps - Light</label>
        <label style="display:block;margin:4px 0;cursor:pointer"><input type="radio" name="provider" checked="@(styleUri == null && mapType == ThinkGeoCloudVectorMapsMapType.Dark)" @onchange="@(() => ShowThinkGeo(ThinkGeoCloudVectorMapsMapType.Dark))" /> ThinkGeo Maps - Dark</label>
        <label style="display:block;margin:4px 0;cursor:pointer"><input type="radio" name="provider" checked="@(styleUri == OpenFreeMapLiberty)" @onchange="@(() => Show(OpenFreeMapLiberty))" /> OpenFreeMap - Liberty</label>
        <label style="display:block;margin:4px 0;cursor:pointer"><input type="radio" name="provider" checked="@(styleUri == OpenFreeMapPositron)" @onchange="@(() => Show(OpenFreeMapPositron))" /> OpenFreeMap - Positron</label>
        <label style="display:block;margin:4px 0;cursor:pointer"><input type="radio" name="provider" checked="@(styleUri == OpenFreeMapDark)" @onchange="@(() => Show(OpenFreeMapDark))" /> OpenFreeMap - Dark</label>
        <label style="display:block;margin:4px 0;cursor:pointer"><input type="radio" name="provider" checked="@custom" @onchange="@(() => Show(customUri.Trim()))" /> Custom map server</label>
        @if (custom)
        {
            <textarea @bind="customUri" rows="3" spellcheck="false" style="width:100%;box-sizing:border-box;font:12px Consolas,monospace"></textarea>
            <button class="btn btn-primary btn-sm" style="align-self:flex-start;margin-top:4px" @onclick="@(() => Show(customUri.Trim()))">Load</button>
        }
        <div style="margin-top:14px;font:11px/1.4 Consolas,monospace;word-break:break-all">@status</div>
        <div style="border-top:1px solid #aaa;margin-top:18px;padding-top:8px;color:#e5e5e5;line-height:1.4">A vector basemap is its style document: the document names the tiles, fonts, and sprites, and the map follows it. ThinkGeo Maps binds its keyed tile source to a published style; OpenFreeMap and any other compatible MVT server are loaded from a style URL.</div>
    </div>
</div>

@code {
    private static readonly PointShape WorldCenter = new PointShape(0, 0);
    private const string OpenFreeMapLiberty = "https://tiles.openfreemap.org/styles/liberty";
    private const string OpenFreeMapPositron = "https://tiles.openfreemap.org/styles/positron";
    private const string OpenFreeMapDark = "https://tiles.openfreemap.org/styles/dark";

    private MapView map;
    private ThinkGeoCloudVectorMapsMapType mapType = ThinkGeoCloudVectorMapsMapType.Light;
    private string styleUri;
    private string customUri = "https://demotiles.maplibre.org/style.json";
    private bool custom;
    private string status = nameof(ThinkGeoCloudVectorMapsOverlay);

    // ThinkGeo Maps binds its keyed tiles to a published style: light and dark are two
    // documents over the same tiles. Any other server is a style URL alone.
    private async Task ShowThinkGeo(ThinkGeoCloudVectorMapsMapType type)
    {
        custom = false;
        styleUri = null;
        mapType = type;
        status = nameof(ThinkGeoCloudVectorMapsOverlay) + " - " + type;
        await RestoreWorldViewAsync();
    }

    private async Task Show(string uri)
    {
        custom = uri == customUri.Trim();
        styleUri = uri;
        status = uri;
        await RestoreWorldViewAsync();
    }

    private async Task RestoreWorldViewAsync()
    {
        await map.SetPitchAsync(0);
        await map.SetBearingAsync(0);
        await map.ZoomToCenterAsync(1, WorldCenter);
    }
}
