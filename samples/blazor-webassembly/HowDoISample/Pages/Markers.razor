@page "/markers"
@using ThinkGeo.Core
@implements IDisposable

<div class="map-container">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10777290, 3908740))" Zoom="15"
                 OnClick="@Clicked" OnReady="@MapReadyAsync">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
            </OverlaysSetting>
            <MarkerOverlaySetting>
                <SimpleMarkerOverlay Id="Pins" @ref="pins" OnClick="@PinClicked" />
            </MarkerOverlaySetting>
            <PopupOverlaySetting>
                <PopupOverlay Id="Info">
                    <PopupSetting>
                        <Popup Id="pin-info" Position="@(picked?.Position)" OffsetY="-36" AutoPan="true">
                            @if (picked != null)
                            {
                                <div style="font:12px system-ui;max-width:240px">
                                    <img src="images/thinkgeo.png" alt="ThinkGeo" style="width:64px;height:64px;float:left;margin:0 8px 6px 0" />
                                    <b>@picked.Id</b>
                                    <p>@(dynamicPins.Contains(picked.Id) ? "An animated beacon anchored to this location." : "A static marker anchored to this location.")</p>
                                    <div>@picked.Position.X.ToString("0"), @picked.Position.Y.ToString("0")</div>
                                    <a href="https://thinkgeo.com" target="_blank" rel="noopener noreferrer">About ThinkGeo</a>
                                </div>
                            }
                        </Popup>
                    </PopupSetting>
                </PopupOverlay>
            </PopupOverlaySetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@(new PointShape(-10777290, 3908740))" CenterButtonZoom="15" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
    <div style="position:absolute;top:12px;right:12px;width:280px;max-height:calc(100% - 24px);overflow:auto;box-sizing:border-box;padding:10px 12px;background:rgba(30,30,30,.85);color:whitesmoke;font:13px system-ui;border-radius:4px">
        <div style="font-weight:600;margin-bottom:6px">Markers &amp; Popups</div>
        <div style="color:#e5e5e5;line-height:1.4">Choose an action, then click the map to add a marker or click an existing marker to view its details or remove it.</div>
        <div style="display:flex;flex-direction:column;gap:5px;margin-top:9px">
            <label><input type="radio" name="marker-action" checked="@(action == "static")" @onchange='() => action = "static"' /> Add static marker</label>
            <label><input type="radio" name="marker-action" checked="@(action == "dynamic")" @onchange='() => action = "dynamic"' /> Add animated marker</label>
            <label><input type="radio" name="marker-action" checked="@(action == "remove")" @onchange='() => action = "remove"' /> Remove marker</label>
            <button class="btn btn-sm btn-light" @onclick="ToggleAnimationAsync">@(animationRunning ? "Pause animation" : "Resume animation")</button>
        </div>
        <div style="display:flex;gap:8px;align-items:center;margin-top:9px">
            <button class="btn btn-sm btn-light" @onclick="ClearAsync">Clear</button>
            <span style="color:#e5e5e5">@count markers</span>
        </div>
    </div>
</div>

@code {
    // Markers made in code: Blazor warns (BL0005) about setting a component's parameters, which is safe here.
#pragma warning disable BL0005
    private string action = "static";
    private bool animationRunning = true;
    private readonly HashSet<string> dynamicPins = new();
    private static readonly PointMarkerStyle Pulsing = new PointMarkerStyle("images/beacon.svg", 0.5, 0.5, 1);
    private static readonly PointMarkerStyle Still = new PointMarkerStyle("images/beacon-still.svg", 0.5, 0.5, 1);
    private MapView map;
    private SimpleMarkerOverlay pins;
    private Marker picked;
    private int count;
    private int next = 1;
    private bool disposed;

    protected override void OnInitialized()
    {
        // The first marker is in place before the overlay reaches the browser.
        Add(new PointShape(-10777290, 3908740));
        Add(new PointShape(-10777800, 3909000), true);
    }

    private void Add(PointShape position, bool animated = false)
    {
        var marker = new Marker { Id = "Pin " + next++, Position = position };
        if (animated)
        {
            dynamicPins.Add(marker.Id);
            marker.Style = animationRunning ? Pulsing : Still;
        }
        // The overlay is the page's own component and is not yet bound the first time.
        (pins?.Markers ?? pending).Add(marker.Id, marker);
        count++;
    }

    private readonly GeoCollection<Marker> pending = new GeoCollection<Marker>();

    private async Task MapReadyAsync()
    {
        foreach (var marker in pending)
        {
            pins.Markers.Add(marker.Id, marker);
        }
        pending.Clear();
        await pins.RedrawAsync();
    }

    private async Task Clicked(ClickedMapViewEventArgs args)
    {
        if (disposed || action == "remove") return;
        await map.WhenReady;
        Add(new PointShape(args.WorldX, args.WorldY), action == "dynamic");
        picked = null;
        await pins.RedrawAsync();
    }

    private async Task PinClicked(ClickedMarkerOverlayEventArgs args)
    {
        if (action == "remove")
        {
            pins.Markers.Remove(args.ClickedMarker.Id);
            dynamicPins.Remove(args.ClickedMarker.Id);
            count = pins.Markers.Count;
            picked = null;
            await pins.RedrawAsync();
            return;
        }
        picked = pins.Markers.Contains(args.ClickedMarker.Id) ? pins.Markers[args.ClickedMarker.Id] : null;
    }

    private async Task ClearAsync()
    {
        if (disposed) return;
        await map.WhenReady;
        pins.Markers.Clear();
        dynamicPins.Clear();
        count = 0;
        picked = null;
        await pins.RedrawAsync();
    }

    private async Task ToggleAnimationAsync()
    {
        animationRunning = !animationRunning;
        foreach (var marker in pins.Markers.Where(marker => dynamicPins.Contains(marker.Id)))
            marker.Style = animationRunning ? Pulsing : Still;
        await pins.RedrawAsync();
    }

    public void Dispose()
    {
        disposed = true;
    }
}
