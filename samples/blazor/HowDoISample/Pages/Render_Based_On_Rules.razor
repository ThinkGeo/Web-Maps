@page "/render-based-on-rules"
@using ThinkGeo.Core
@using System.Text.Json.Nodes
@implements IDisposable

@{
    var initialCenter = new PointShape(0, 0);
}

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@initialCenter" Zoom="2" Bearing="0" Pitch="0">
            <OverlaysSetting>
                <VectorTileOverlay Id="Countries" StyleJson="@applied" FeatureSources="@sources" SourceId="features" />
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@initialCenter" CenterButtonZoom="2" CenterButtonBearing="0" CenterButtonPitch="0" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@initialCenter" Zoom="2" Bearing="0" Pitch="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
    </div>
    <div style="width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;padding:8px;display:flex;flex-direction:column;background:dimgray;color:whitesmoke;font:13px system-ui;min-height:0">
        <div style="font-size:16px;font-weight:600;margin-bottom:6px">Render Based on Rules</div>
        <div style="color:#e5e5e5;font-size:11px;line-height:1.35;margin-bottom:8px">Compare match, step, filter and case expressions on the country currency and population data.</div>
        <div style="font-weight:700;margin-bottom:4px">Rule</div>
        <div style="display:flex;flex-direction:column;gap:5px;margin-bottom:8px">
            <label style="cursor:pointer"><input type="radio" name="rule" checked="@(rule == RuleMatch)" @onchange="@(() => Pick(RuleMatch))" /> Values - match</label>
            <label style="cursor:pointer"><input type="radio" name="rule" checked="@(rule == RuleStep)" @onchange="@(() => Pick(RuleStep))" /> Ranges - step</label>
            <label style="cursor:pointer"><input type="radio" name="rule" checked="@(rule == RuleFilter)" @onchange="@(() => Pick(RuleFilter))" /> Only what passes - filter</label>
            <label style="cursor:pointer"><input type="radio" name="rule" checked="@(rule == RuleCase)" @onchange="@(() => Pick(RuleCase))" /> Any condition - case</label>
        </div>
        <div style="font-weight:700;margin-bottom:4px">style.json - edit it; the map follows</div>
        <textarea @bind="styleJson" @bind:event="oninput" @bind:after="EditorChanged" spellcheck="false"
                  style="flex:1;min-height:0;width:100%;box-sizing:border-box;font:11px/1.35 Consolas,monospace;padding:7px;border:1px solid #aaa;background:#fff;color:#111;resize:none;white-space:pre-wrap;overflow-wrap:anywhere;overflow-x:hidden;overflow-y:auto"></textarea>
        <div role="status" style="padding-top:5px;line-height:1.3;overflow-wrap:anywhere;color:@(ok ? "#baf1ba" : "#ffd0b8")">@status</div>
    </div>
</div>

@code {
    // One dataset, four expressions - match, step, filter and case: the classic ValueStyle,
    // ClassBreakStyle, FilterStyle and boolean-expression styles are one mechanism, an
    // expression in the layer's paint. Every rule ends in a default, so a feature no
    // condition matches still has a look.
    private const string RuleMatch = @"{
  ""layers"": [
    { ""type"": ""background"",
      ""paint"": { ""background-color"": ""#DDE8F0"" } },

    { ""type"": ""fill"",
      ""source-layer"": ""Countries02"",
      ""paint"": {
          ""fill-outline-color"": ""#FFFFFF"",
          ""fill-color"": [""match"", [""get"", ""CURR_TYPE""],
              ""Dollar"", ""rgba(31,119,180,0.8)"",
              ""Franc"", ""rgba(44,160,44,0.8)"",
              ""Pound"", ""rgba(214,39,40,0.8)"",
              ""Peso"", ""rgba(148,103,189,0.8)"",
              ""rgba(233,232,214,0.8)""] }
    }
  ]
}";

    private const string RuleStep = @"{
  ""layers"": [
    { ""type"": ""background"",
      ""paint"": { ""background-color"": ""#DDE8F0"" } },

    { ""type"": ""fill"",
      ""source-layer"": ""Countries02"",
      ""paint"": {
          ""fill-outline-color"": ""#FFFFFF"",
          ""fill-color"": [""step"", [""to-number"", [""get"", ""POP_CNTRY""]],
              ""rgba(233,232,214,0.85)"",
              1000000, ""rgba(253,208,162,0.85)"",
              10000000, ""rgba(253,141,60,0.85)"",
              50000000, ""rgba(217,71,1,0.85)"",
              200000000, ""rgba(127,39,4,0.85)""] }
    }
  ]
}";

    private const string RuleFilter = @"{
  ""layers"": [
    { ""type"": ""background"",
      ""paint"": { ""background-color"": ""#DDE8F0"" } },

    { ""type"": ""fill"",
      ""source-layer"": ""Countries02"",
      ""paint"": {
          ""fill-color"": ""rgba(233,232,214,0.8)"",
          ""fill-outline-color"": ""#FFFFFF"" }
    },

    { ""type"": ""fill"",
      ""source-layer"": ""Countries02"",
      ""filter"": [""=="", [""get"", ""LANDLOCKED""], ""Y""],
      ""paint"": {
          ""fill-color"": ""rgba(46,139,87,0.8)"",
          ""fill-outline-color"": ""#FFFFFF"" }
    }
  ]
}";

    private const string RuleCase = @"{
  ""layers"": [
    { ""type"": ""background"",
      ""paint"": { ""background-color"": ""#DDE8F0"" } },

    { ""type"": ""fill"",
      ""source-layer"": ""Countries02"",
      ""paint"": {
          ""fill-outline-color"": ""#FFFFFF"",
          ""fill-color"": [""case"",
              [""all"", ["">"", [""to-number"", [""get"", ""POP_CNTRY""]], 10000000],
                      [""=="", [""get"", ""LANDLOCKED""], ""Y""]],
              ""rgba(255,255,0,0.8)"",
              ""rgba(233,232,214,0.8)""] }
    }
  ]
}";

    private MapView map;
    private GeoCollection<FeatureSource> sources;
    private string rule = RuleMatch;
    private string styleJson = RuleMatch;
    private string applied = RuleMatch;
    private string status = "";
    private bool ok = true;
    private int edit;
    private bool disposed;

    protected override void OnInitialized()
    {
        sources = new GeoCollection<FeatureSource>
        {
            { "Countries02", new ShapeFileFeatureSource("./Data/Shapefile/Countries02.shp") { ProjectionConverter = new ProjectionConverter(4326, 3857) } },
        };
    }

    private void Pick(string chosen)
    {
        if (disposed) return;
        edit++;
        rule = chosen;
        styleJson = chosen;
        applied = chosen;
        ok = true;
        status = $"applied at {DateTime.Now:HH:mm:ss}";
    }

    // A document that does not parse changes nothing; the map keeps the last one that did.
    private async Task EditorChanged()
    {
        var mine = ++edit;
        await Task.Delay(400);
        if (mine != edit || disposed) return;

        try
        {
            if (JsonNode.Parse(styleJson) is not JsonObject document || document["layers"] is not JsonArray)
                throw new FormatException("The style needs a layers array.");
            applied = styleJson;
            ok = true;
            status = $"applied at {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception exception)
        {
            ok = false;
            status = "not applied - " + exception.Message.Split('\n')[0].TrimEnd('\r') + "   (the map is still drawing the last document that worked)";
        }
    }

    public void Dispose()
    {
        disposed = true;
        edit++;
    }
}
