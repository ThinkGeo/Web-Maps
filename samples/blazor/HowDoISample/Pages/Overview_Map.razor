@page "/overview-map"
@using ThinkGeo.Core

<style>
    /* Keep the overview usable at 220px while leaving its attribution available on focus or hover. */
    #overview .maplibregl-ctrl-attrib .maplibregl-ctrl-attrib-inner { display: none; }
    #overview .maplibregl-ctrl-attrib:hover .maplibregl-ctrl-attrib-inner,
    #overview .maplibregl-ctrl-attrib:focus-within .maplibregl-ctrl-attrib-inner { display: block; }
</style>

<div class="map-container" style="position:relative">
        <MapView Id="main" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-9338030, 3300450))" Zoom="6"
                 OnCurrentExtentChanged="@MainMoved" OnCurrentExtentChanging="@MainMoving">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft"
                                    UseNavigationStyle="true"
                                    CenterButtonCenter="@(new PointShape(-9338030, 3300450))"
                                    CenterButtonZoom="6" CenterButtonBearing="0" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@(new PointShape(-9338030, 3300450))" Zoom="6" Bearing="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
        <div style="position:absolute;left:8px;bottom:8px;width:220px;height:220px;box-sizing:border-box;border:3px solid #333;border-radius:6px;overflow:hidden;background:#fff">
            <MapView Id="overview" @ref="overview" MapUnit="GeographyUnit.Meter"
                     Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                     Center="@(new PointShape(-10502930, 4330070))" Zoom="2"
                     OnCurrentExtentChanged="@OverviewMoved" OnClick="@OverviewClicked">
                <OverlaysSetting>
                    <ThinkGeoCloudVectorMapsOverlay Id="OverviewBasemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                    ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                </OverlaysSetting>
            </MapView>
            @if (framePoints != null)
            {
                <svg viewBox="0 0 214 214" preserveAspectRatio="none" aria-hidden="true"
                     style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1">
                    <polygon points="@framePoints" fill="rgba(255,0,0,.13)" stroke="red" stroke-width="2" />
                    <image href="/images/overview_navigation_arrow.svg" x="@markerX" y="@markerY" width="20" height="20"
                           transform="@markerTransform" />
                </svg>
            }
        </div>
</div>

@code {
    private MapView map;
    private MapView overview;
    private RectangleShape mainExtent;
    private RectangleShape previewExtent;
    private string framePoints;
    private string markerX;
    private string markerY;
    private string markerTransform;
    private double bearing;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Both child maps initialize asynchronously. Draw the frame once they are ready,
        // even when their initial extent events arrived before the other map loaded.
        for (var attempt = 0; attempt < 30 && (map?.IsLoaded != true || overview?.IsLoaded != true); attempt++)
            await Task.Delay(100);

        if (map?.IsLoaded == true && overview?.IsLoaded == true)
        {
            mainExtent = await map.GetCurrentExtentAsync();
            bearing = await map.GetBearingAsync();
            await UpdateFrameAsync();
            StateHasChanged();
        }
    }

    private async Task MainMoved(CurrentExtentChangedMapViewEventArgs args)
    {
        mainExtent = args.CurrentExtent;
        bearing = await map.GetBearingAsync();
        await UpdateFrameAsync(previewExtent);
    }

    private Task MainMoving(CurrentExtentChangingMapViewEventArgs args)
    {
        mainExtent = args.CurrentExtent;
        bearing = args.Bearing;
        return UpdateFrameAsync(previewExtent);
    }

    private Task OverviewMoved(CurrentExtentChangedMapViewEventArgs args) => UpdateFrameAsync(args.CurrentExtent);

    private async Task UpdateFrameAsync(RectangleShape currentPreviewExtent = null)
    {
        if (mainExtent == null || overview?.IsLoaded != true) return;
        currentPreviewExtent ??= await overview.GetCurrentExtentAsync();
        if (currentPreviewExtent == null) return;

        // Keep the selected area in the preview when the main map moves away.
        if (!currentPreviewExtent.Contains(mainExtent.GetCenterPoint()))
        {
            await overview.SetCenterAsync(mainExtent.GetCenterPoint());
            currentPreviewExtent = await overview.GetCurrentExtentAsync();
        }
        previewExtent = currentPreviewExtent;

        (double x, double y) Pixel(double worldX, double worldY) =>
            (214 * (worldX - currentPreviewExtent.UpperLeftPoint.X) / currentPreviewExtent.Width,
             214 * (currentPreviewExtent.UpperLeftPoint.Y - worldY) / currentPreviewExtent.Height);

        var upperLeft = Pixel(mainExtent.UpperLeftPoint.X, mainExtent.UpperLeftPoint.Y);
        var lowerRight = Pixel(mainExtent.LowerRightPoint.X, mainExtent.LowerRightPoint.Y);
        var center = Pixel(mainExtent.GetCenterPoint().X, mainExtent.GetCenterPoint().Y);
        framePoints = FormattableString.Invariant($"{upperLeft.x},{upperLeft.y} {lowerRight.x},{upperLeft.y} {lowerRight.x},{lowerRight.y} {upperLeft.x},{lowerRight.y}");
        markerX = FormattableString.Invariant($"{center.x - 10:0.###}");
        markerY = FormattableString.Invariant($"{center.y - 10:0.###}");
        // The overview remains north-up; rotate the arrow opposite the main map's bearing
        // so its tip tracks north as the main camera turns.
        markerTransform = FormattableString.Invariant($"rotate({-bearing:0.###} {center.x:0.###} {center.y:0.###})");
    }

    private Task OverviewClicked(ClickedMapViewEventArgs args) => map.SetCenterAsync(new PointShape(args.WorldX, args.WorldY));
}
