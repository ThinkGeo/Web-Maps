@inject MenuService menuService
@inject NavigationManager navigationManager

<ul id="menu-bar" class="nav nav-sidebar">
    @if (menus != null)
    {
        @foreach (var menu in menus.Where(m => string.IsNullOrEmpty(m.Group)))
        {
            <li class="@(GetCss(menu.Id))">
                <NavLink @key="menu" href="@menu.Href" @onclick="@(e => HandleOnMenuClick(menu))" Match="NavLinkMatch.All"><span class="sub-arrow @menu.Preicon">@menu.Title</span></NavLink>
            </li>
        }

        @foreach (var group in menus.Where(m => !string.IsNullOrEmpty(m.Group)).GroupBy(m => m.Group))
        {
            <li class="menu-group @(IsOpen(group.Key) ? "open" : "")">
                <a class="menu-group-title" @onclick="@(e => Toggle(group.Key))">
                    <span class="sub-arrow @(IsOpen(group.Key) ? "fas fa-chevron-down" : "fas fa-chevron-right")">@group.Key</span>
                </a>
            </li>
            @if (IsOpen(group.Key))
            {
                @foreach (var menu in group)
                {
                    <li class="menu-group-item @(GetCss(menu.Id))">
                        <NavLink @key="menu" href="@menu.Href" @onclick="@(e => HandleOnMenuClick(menu))" Match="NavLinkMatch.All"><span class="sub-arrow @menu.Preicon">@menu.Title</span></NavLink>
                    </li>
                }
            }
        }
    }
</ul>

@code {
    private List<MenuModel> menus;
    private bool isLoaded;
    private MenuModel currentMenu;
    private readonly HashSet<string> openGroups = new HashSet<string>();

    [Parameter]
    public EventCallback<MenuModel> OnMenuClick { get; set; }

    async void HandleOnMenuClick(MenuModel menu)
    {
        currentMenu = menu;
        if (OnMenuClick.HasDelegate)
        {
            await OnMenuClick.InvokeAsync(menu);
        }
    }

    protected override void OnInitialized()
    {
        menus = menuService.GetMenus();
        var currentUri = navigationManager.Uri;
        var lastSlashIndex = currentUri.LastIndexOf('/') + 1;
        var queryStringIndex = currentUri.IndexOf('?');
        var currentPath = queryStringIndex == -1 ? currentUri.Substring(lastSlashIndex) : currentUri.Substring(lastSlashIndex, queryStringIndex - lastSlashIndex);
        currentMenu = menus.FirstOrDefault(p => currentPath == p.Href) ?? menus[0];

        // The group the current sample sits in starts open, so a link into a sample lands on it.
        if (!string.IsNullOrEmpty(currentMenu.Group))
        {
            openGroups.Add(currentMenu.Group);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!isLoaded)
        {
            HandleOnMenuClick(currentMenu);
            isLoaded = true;
        }
    }

    private bool IsOpen(string group) => openGroups.Contains(group);

    private void Toggle(string group)
    {
        if (!openGroups.Remove(group))
        {
            openGroups.Add(group);
        }
    }

    string GetCss(string menuId)
    {
        return currentMenu?.Id == menuId ? "active" : string.Empty;
    }
}
