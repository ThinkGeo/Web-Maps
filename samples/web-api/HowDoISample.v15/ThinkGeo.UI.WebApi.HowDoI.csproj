<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThinkGeo.UI.WebApi.HowDoI</RootNamespace>
    <AssemblyName>ThinkGeo.UI.WebApi.HowDoI</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="D:\Source\thinkgeosdk-webapi\ThinkGeo.Core\Core\ThinkGeo.Core.csproj" />
    <ProjectReference Include="D:\Source\thinkgeosdk-webapi\ThinkGeo.UI\Web\ThinkGeo.UI.WebApi\ThinkGeo.UI.WebApi.csproj" />
    <ProjectReference Include="D:\Source\thinkgeosdk-webapi\ThinkGeo.Core\Extensions\Gdal\ThinkGeo.Gdal.csproj" />
    <ProjectReference Include="D:\Source\thinkgeosdk-webapi\ThinkGeo.Core\Extensions\FileGeoDatabase\ThinkGeo.FileGeoDatabase.csproj" />
    <ProjectReference Include="D:\Source\thinkgeosdk-webapi\ThinkGeo.Core\Extensions\NauticalCharts\ThinkGeo.NauticalCharts.csproj" />
    <ProjectReference Include="D:\Source\thinkgeosdk-webapi\ThinkGeo.Core\Extensions\PostgreSql\ThinkGeo.PostgreSql.csproj" />
    <ProjectReference Include="D:\Source\thinkgeosdk-webapi\ThinkGeo.Core\Extensions\SqlServer\ThinkGeo.SqlServer.csproj" />
  </ItemGroup>

  <!-- The sample data is the Blazor gallery's, linked in rather than copied: the two galleries
       show the same files. It is copied next to the binaries on build and publish, and read
       from there (see SampleData). -->
  <ItemGroup>
    <Content Include="..\..\blazor\HowDoISample\Data\**" Exclude="..\..\blazor\HowDoISample\Data\temp\**" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The Legacy group's own data, from the classic WebAPI samples. -->
    <Content Include="Data\Legacy\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The code pane shows each sample's server source beside its page; the .cs files go out
       with the site for it to read. -->
  <Target Name="PublishSampleSources" AfterTargets="Publish">
    <ItemGroup>
      <SampleSource Include="Samples\**\*.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(SampleSource)" DestinationFiles="@(SampleSource->'$(PublishDir)Samples\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
