@page "/"
@page "/map-navigation"
@using System.Globalization
@using ThinkGeo.Core
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="map-container" style="display:flex">
    <div style="position:relative;flex:1;min-width:0">
        @* Pan, zoom, rotate and tilt are built into the map. The readout follows the view. *@
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@EmpireStateBuildingPosition" Zoom="12" Bearing="@InitialBearing" Pitch="@pitch"
                 OnCurrentExtentChanged="ExtentChanged">
            <OverlaysSetting>
                @if (basemapStyle != null)
                {
                    <VectorTileOverlay Id="Basemap" Style="@basemapStyle" />
                }
            </OverlaysSetting>
            <MarkerOverlaySetting>
                <SimpleMarkerOverlay Id="EmpireStateBuilding">
                    <MarkersSetting>
                        <Marker Id="Empire State Building"
                                Position="@EmpireStateBuildingPosition"
                                Style="@EmpireStateBuildingStyle" />
                    </MarkersSetting>
                </SimpleMarkerOverlay>
            </MarkerOverlaySetting>
        </MapView>

        <div id="map-navigation-bar" style="position:absolute;top:10px;left:10px;width:58px;z-index:2;user-select:none">
            <div style="position:relative;width:58px;height:58px;border-radius:50%;background:rgba(255,255,255,.96);box-shadow:0 1px 5px rgba(0,0,0,.45)">
                <button data-pan="up" title="Pan up" aria-label="Pan up" style="position:absolute;top:3px;left:19px;width:20px;height:18px;padding:0;border:0;background:transparent;cursor:pointer"><span style="display:block;margin:auto;width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-bottom:9px solid #0878d1"></span></button>
                <button data-pan="left" title="Pan left" aria-label="Pan left" style="position:absolute;top:19px;left:3px;width:18px;height:20px;padding:0;border:0;background:transparent;cursor:pointer"><span style="display:block;margin:auto;width:0;height:0;border-top:6px solid transparent;border-bottom:6px solid transparent;border-right:9px solid #0878d1"></span></button>
                <button data-home title="Return to Empire State Building" aria-label="Return to Empire State Building"
                        style="position:absolute;top:25px;left:25px;width:8px;height:8px;padding:0;border:0;border-radius:50%;background:#0878d1;cursor:pointer"></button>
                <button data-pan="right" title="Pan right" aria-label="Pan right" style="position:absolute;top:19px;right:3px;width:18px;height:20px;padding:0;border:0;background:transparent;cursor:pointer"><span style="display:block;margin:auto;width:0;height:0;border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:9px solid #0878d1"></span></button>
                <button data-pan="down" title="Pan down" aria-label="Pan down" style="position:absolute;bottom:3px;left:19px;width:20px;height:18px;padding:0;border:0;background:transparent;cursor:pointer"><span style="display:block;margin:auto;width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:9px solid #0878d1"></span></button>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;margin-top:5px">
                <button data-zoom="in" title="Zoom in" aria-label="Zoom in" style="width:20px;height:20px;padding:0;border:1px solid #aaa;border-radius:4px;background:linear-gradient(#fff,#ddd);color:#333;font:bold 18px/16px Arial;cursor:pointer">+</button>
                <input data-zoom-slider title="Zoom level" aria-label="Zoom level" type="range" min="0" max="20" step="0.01"
                       style="width:20px;height:116px;margin:2px 0;writing-mode:vertical-lr;direction:rtl;accent-color:#bcbcbc;cursor:pointer" />
                <button data-zoom="out" title="Zoom out" aria-label="Zoom out" style="width:20px;height:20px;padding:0;border:1px solid #aaa;border-radius:4px;background:linear-gradient(#fff,#ddd);color:#333;font:bold 18px/16px Arial;cursor:pointer">−</button>
            </div>
        </div>

        <button id="map-navigation-compass" title="Reset North" @onclick="ResetNorthAsync"
                style="position:absolute;top:10px;right:10px;width:40px;height:40px;padding:0;border:0;background:transparent;cursor:pointer;transform:rotate(@(-currentBearing)deg);transform-origin:center">
            <img src="images/icon_north_arrow.png" alt="Reset North" style="display:block;width:40px;height:40px" />
        </button>

        <button title="Reset to Default Extent" @onclick="ResetDefaultExtentAsync"
                style="position:absolute;top:60px;right:10px;width:40px;height:40px;padding:0;border:0;background:transparent;cursor:pointer">
            <img src="images/icon_globe_black.png" alt="Reset to Default Extent" style="display:block;width:40px;height:40px" />
        </button>

        <div style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);text-align:center;color:#111;font:20px system-ui;white-space:nowrap">
            <div style="display:inline-block;padding:2px 8px;background:rgba(230,230,230,.9)">@coordinateReadout</div>
            <br />
            <div style="display:inline-block;padding:2px 8px;background:rgba(230,230,230,.9)">@cameraReadout</div>
        </div>
    </div>

    <div style="width:250px;flex:0 0 250px;box-sizing:border-box;margin-left:10px;padding:0 0 10px;background:dimgray;color:whitesmoke;font:13px system-ui">
        <div style="font-size:16px;font-weight:600;margin-bottom:6px">Camera</div>

        <label style="display:flex;align-items:center;gap:5px;cursor:pointer">
            <input type="checkbox" checked="@buildingsVisible" @onchange="ToggleBuildings" />
            3D Buildings
        </label>

        <label style="display:flex;align-items:center;margin-top:8px">
            <span style="margin-right:8px">Pitch</span>
            <input type="range" min="0" max="80" step="1" value="@pitch"
                   @oninput="PitchChanged" style="flex:1;min-width:0" />
            <span style="width:38px;text-align:right">@pitch.ToString("0")&deg;</span>
        </label>

        <button style="width:100%;height:28px;margin-top:10px;border:0;cursor:pointer"
                @onclick="ToggleTheme">@(darkTheme ? "Light Theme" : "Dark Theme")</button>
    </div>
</div>

@code {
    private const double InitialBearing = 30;

    private static readonly PointShape EmpireStateBuildingPosition =
        ProjectionConverter.Convert(4326, 3857, new PointShape(-73.9856654, 40.74843661));

    private static readonly PointMarkerStyle EmpireStateBuildingStyle =
        new PointMarkerStyle("images/empire_state_building.png", 0.5, 1, 0.1);

    private MapView map;
    private MapStyle basemapStyle;
    private MapStyle basemapWithBuildings;
    private MapStyle basemapWithoutBuildings;
    private string coordinateReadout = "";
    private string cameraReadout = "";
    private PointShape currentCenter = EmpireStateBuildingPosition;
    private double currentBearing = InitialBearing;
    private double currentScale = 100000;
    private double initialExtentWidth;
    private double pitch;
    private bool buildingsVisible = true;
    private bool darkTheme;

    protected override async Task OnInitializedAsync()
    {
        await BuildBasemapStylesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("howDoI.bindBearingIndicator", "map", "map-navigation-compass");
            await JS.InvokeVoidAsync("howDoI.bindNavigationBar", "map", "map-navigation-bar");
        }
    }

    private async Task ExtentChanged(CurrentExtentChangedMapViewEventArgs e)
    {
        var center = e.CurrentExtent.GetCenterPoint();
        currentCenter = center;
        var lonLat = ProjectionConverter.Convert(3857, 4326, center);
        coordinateReadout = string.Format(CultureInfo.InvariantCulture, "Center Point: (Lat: {0:N4}, Lon: {1:N4})", lonLat.Y, lonLat.X);

        if (initialExtentWidth <= 0)
        {
            initialExtentWidth = e.CurrentExtent.Width;
        }

        var zoom = 12 + Math.Log(initialExtentWidth / e.CurrentExtent.Width, 2);
        var initialScale = map.ZoomScales[11];
        var scale = initialScale / Math.Pow(2, zoom - 12);
        currentScale = scale;
        currentBearing = await map.GetBearingAsync();
        var rotation = -currentBearing;
        cameraReadout = string.Format(
            CultureInfo.InvariantCulture,
            "Rotation: {0:N0}   Zoom: {1:N2}   Scale: {2:N0}",
            rotation,
            zoom,
            scale);
    }

    private Task ResetNorthAsync()
    {
        return map.ZoomToAsync(currentCenter, currentScale, 0, 0);
    }

    private Task ResetDefaultExtentAsync()
    {
        return map.ZoomToAsync(EmpireStateBuildingPosition, 100000, InitialBearing, 0);
    }

    private void PitchChanged(ChangeEventArgs e)
    {
        pitch = double.Parse((string)e.Value, CultureInfo.InvariantCulture);
    }

    private void ToggleBuildings(ChangeEventArgs e)
    {
        buildingsVisible = (bool)e.Value;
        basemapStyle = buildingsVisible ? basemapWithBuildings : basemapWithoutBuildings;
    }

    private async Task ToggleTheme()
    {
        darkTheme = !darkTheme;
        await BuildBasemapStylesAsync();
    }

    private async Task BuildBasemapStylesAsync()
    {
        var styleUri = darkTheme ? ThinkGeoVectorStyles.Dark : ThinkGeoVectorStyles.Light;
        basemapWithBuildings = new MapStyle(
            styleUri,
            new ThinkGeoVectorTileSource(GlobalSettings.ThinkGeoApiKey));
        basemapWithoutBuildings = new MapStyle(
            styleUri,
            new ThinkGeoVectorTileSource(GlobalSettings.ThinkGeoApiKey));

        // Resolve both documents now, so the checkbox only swaps an already prepared style.
        await Task.WhenAll(
            basemapWithBuildings.GetStyleLayersAsync(),
            basemapWithoutBuildings.GetStyleLayersAsync());
        basemapWithoutBuildings.SetLayerVisibility("buildings-3d", false);

        basemapStyle = buildingsVisible ? basemapWithBuildings : basemapWithoutBuildings;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("howDoI.unbindBearingIndicator", "map", "map-navigation-compass");
            await JS.InvokeVoidAsync("howDoI.unbindNavigationBar", "map", "map-navigation-bar");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
