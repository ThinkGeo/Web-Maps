@page "/display-dot-density"
@using ThinkGeo.Core
@using System.Text.Json.Nodes
@using System.Globalization
@using System.Collections.ObjectModel

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10650000, 4600000))" Zoom="4">
            <OverlaysSetting>
                <VectorTileOverlay Id="Dots" StyleJson="@applied" FeatureSources="@sources" SourceId="features" />
            </OverlaysSetting>
        </MapView>
        <div style="position:absolute;left:12px;bottom:12px;padding:8px 10px;background:rgba(255,255,255,.92);border-radius:4px;font:12px system-ui;box-shadow:0 1px 4px rgba(0,0,0,.25)">
            <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#1F78B4"></span> Owner-occupied
            <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#F07814;margin-left:12px"></span> Renter-occupied
            <div style="color:#555;margin-top:4px">1 dot = 25,000 housing units (1990 census)</div>
        </div>
    </div>
    <div style="width:420px;display:flex;flex-direction:column;background:#f6f6f4;border-left:1px solid #ccc;font:12px system-ui">
        <div style="padding:8px 8px 4px;font-weight:600">style.json - edit it; the map follows</div>
        <div style="padding:0 8px 6px;color:#555">Two colours of dot scattered inside each state, one per 25,000 housing units - countable, and a composition a heatmap cannot show. The dots are generated once as data; the style only colours them.</div>
        <textarea @bind="styleJson" @bind:event="oninput" @bind:after="EditorChanged" spellcheck="false"
                  style="flex:1;font:11.5px Consolas,monospace;padding:6px;border:0;border-top:1px solid #ccc;resize:none;white-space:pre"></textarea>
        <div style="padding:4px 8px 6px;color:@(ok ? "darkgreen" : "firebrick")">@status</div>
    </div>
</div>

@code {
    private const int UnitsPerDot = 25_000;

    private const string StyleJson = @"{
  ""layers"": [
    { ""type"": ""background"",
      ""paint"": { ""background-color"": ""#DDE8F0"" } },

    { ""type"": ""fill"",
      ""source-layer"": ""USStates_3857"",
      ""paint"": {
          ""fill-color"": ""#FCFCFA"",
          ""fill-outline-color"": ""#787878"" }
    },

    { ""type"": ""circle"",
      ""source-layer"": ""owner"",
      ""paint"": {
          ""circle-radius"": 1.9,
          ""circle-color"": ""#1F78B4"" }
    },

    { ""type"": ""circle"",
      ""source-layer"": ""renter"",
      ""paint"": {
          ""circle-radius"": 1.9,
          ""circle-color"": ""#F07814"" }
    }
  ]
}";

    private MapView map;
    private GeoCollection<FeatureSource> sources;
    private string styleJson = StyleJson;
    private string applied = StyleJson;
    private string status = "";
    private bool ok = true;
    private int edit;

    protected override void OnInitialized()
    {
        var states = new ShapeFileFeatureSource("./Data/Shapefile/USStates_3857.shp");
        states.Open();
        var features = states.GetAllFeatures(new[] { "OWNER_OCC", "RENTER_OCC" });
        states.Close();

        sources = new GeoCollection<FeatureSource>
        {
            { "USStates_3857", new ShapeFileFeatureSource("./Data/Shapefile/USStates_3857.shp") },
            { "owner", Scatter(features, "OWNER_OCC", seed: 1) },
            { "renter", Scatter(features, "RENTER_OCC", seed: 2) },
        };
    }

    // One dot per 25,000 units, dropped at random inside the state until enough have landed.
    private static FeatureSource Scatter(IEnumerable<Feature> states, string column, int seed)
    {
        var dots = new Collection<Feature>();
        var stateIndex = 0;
        foreach (var state in states)
        {
            stateIndex++;
            if (!(state.GetShape() is AreaBaseShape area) ||
                !state.ColumnValues.TryGetValue(column, out var raw) ||
                !double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var units))
            {
                continue;
            }

            var wanted = (int)Math.Round(units / UnitsPerDot);
            var box = area.GetBoundingBox();
            var random = new Random((seed * 7919) + stateIndex);
            var placed = 0;
            for (var attempts = 0; placed < wanted && attempts < wanted * 60; attempts++)
            {
                var candidate = new PointShape(box.LowerLeftPoint.X + (random.NextDouble() * box.Width), box.LowerLeftPoint.Y + (random.NextDouble() * box.Height));
                if (!area.Contains(candidate)) continue;
                dots.Add(new Feature(candidate));
                placed++;
            }
        }
        return new InMemoryFeatureSource(Array.Empty<FeatureSourceColumn>(), dots);
    }

    // A document that does not parse changes nothing; the map keeps the last one that did.
    private async Task EditorChanged()
    {
        var mine = ++edit;
        await Task.Delay(400);
        if (mine != edit) return;

        try
        {
            JsonNode.Parse(styleJson);
            applied = styleJson;
            ok = true;
            status = $"applied at {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception exception)
        {
            ok = false;
            status = "not applied - " + exception.Message.Split('\n')[0].TrimEnd('\r');
        }
    }
}
