@page "/shape-operations"
@using ThinkGeo.Core
@using System.Text.Json.Nodes
@using System.Globalization
@using System.Collections.ObjectModel
@implements IDisposable

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10782000, 3911500))" Zoom="12">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Shapes" @ref="overlay" Style="@style" FeatureSources="@sources" SourceId="shapes" />
            </OverlaysSetting>
        </MapView>
    </div>
    <div style="width:320px;display:flex;flex-direction:column;background:#f6f6f4;border-left:1px solid #ccc;font:12px system-ui">
        <div style="padding:8px 8px 4px;font-weight:600">Operation</div>
        <div style="padding:0 8px 6px;display:flex;flex-direction:column;gap:2px">
            @foreach (var name in Operations)
            {
                <label><input type="radio" name="operation" checked="@(operation == name)" @onchange="@(() => Choose(name))" /> @name</label>
            }
        </div>
        @if (operation == "Union of all the pieces")
        {
            <div style="padding:0 8px 6px;display:flex;flex-direction:column;gap:4px">
                <div>@unionNote</div>
                <button class="btn btn-sm btn-primary" disabled="@merged" @onclick="@(() => Merge(true))">Merge them into one</button>
                <button class="btn btn-sm btn-light" disabled="@(!merged)" @onclick="@(() => Merge(false))">Separate them again</button>
            </div>
        }
        else if (Parameters(operation).First != null)
        {
            <div style="padding:0 8px 6px;display:flex;flex-direction:column;gap:4px">
                <label>@Parameters(operation).First <input @bind="first" @bind:event="oninput" @bind:after="Apply" style="width:80px" /></label>
                @if (Parameters(operation).Second != null)
                {
                    <label>@Parameters(operation).Second <input @bind="second" @bind:event="oninput" @bind:after="Apply" style="width:80px" /></label>
                }
                <label><input type="checkbox" checked="@animate" @onchange="@ToggleAnimation" /> Animate it</label>
            </div>
        }
        <div style="padding:0 8px 6px;color:#555">Orange is the shape read from the file, green what the operation makes of it, blue the area the paired operations use.</div>
    </div>
</div>

@code {
    private const string WestRegionWkt =
        "POLYGON((-10780139 3918539, -10780206 3915600, -10780037 3913978, -10779176 3913336, " +
        "-10778280 3911934, -10778263 3910684, -10778382 3909569, -10778280 3907356, " +
        "-10785595 3904045, -10786034 3904822, -10786001 3908150, -10785933 3909315, " +
        "-10786001 3911275, -10785832 3914485, -10785832 3917728, -10785460 3919012, " +
        "-10782233 3918995, -10780139 3918539))";

    private static readonly string[] Operations =
    {
        "Buffer", "Simplify", "Rotate", "Scale", "Translate", "Convex hull", "Envelope",
        "Intersection with the blue area", "Difference from the blue area", "Union of all the pieces"
    };
    private static readonly string[] PieceColors = { "rgba(255,200,120,0.5)", "rgba(147,112,219,0.5)" };

    private MapView map;
    private VectorTileOverlay overlay;
    private GeoCollection<FeatureSource> sources;
    private MapStyle style;
    private readonly InMemoryFeatureSource source = new InMemoryFeatureSource(new[] { new FeatureSourceColumn("color") });
    private readonly InMemoryFeatureSource region = new InMemoryFeatureSource();
    private readonly InMemoryFeatureSource outcome = new InMemoryFeatureSource();
    private readonly PolygonShape westRegion = new PolygonShape(WestRegionWkt);
    private Collection<Feature> pieces;
    private RectangleShape bounds;
    private string operation = Operations[0];
    private string first = "1000";
    private string second = "3000";
    private bool merged;
    private bool animate;
    private double phase;
    private string unionNote = "";
    private CancellationTokenSource animation;

    protected override void OnInitialized()
    {
        var file = new ShapeFileFeatureSource("./Data/Shapefile/FriscoCityLimitsDivided.shp") { ProjectionConverter = new ProjectionConverter(2276, 3857) };
        file.Open();
        pieces = file.GetAllFeatures(ReturningColumnsType.NoColumns);
        bounds = file.GetBoundingBox();
        file.Close();

        sources = new GeoCollection<FeatureSource> { { "source", source }, { "region", region }, { "result", outcome } };
        style = new MapStyle()
            .AddFillLayer("region", "shapes", "region", new FillPaint(new GeoColor(32, GeoColors.Blue), outlineColor: GeoColors.Blue))
            .AddLayer(new JsonObject
{
    ["id"] = "source", ["type"] = "fill", ["source"] = "shapes", ["source-layer"] = "source",
    ["paint"] = new JsonObject { ["fill-color"] = StyleExpressions.Get("color") },
})
            .AddFillLayer("result", "shapes", "result", new FillPaint(new GeoColor(96, GeoColors.Green)))
            .AddLineLayer("result-edge", "shapes", "result", new LinePaint(GeoColors.DarkGreen, 2f));
        Compute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        for (var attempt = 0; attempt < 80 && map?.IsLoaded != true; attempt++)
        {
            await Task.Delay(250);
        }
        var framed = new RectangleShape(bounds.UpperLeftPoint, bounds.LowerRightPoint);
        framed.ScaleUp(50);
        await map.ZoomToExtentAsync(framed);
    }

    private async Task Choose(string name)
    {
        operation = name;
        merged = false;
        phase = 0;
        var parameters = Parameters(name);
        first = parameters.FirstValue;
        second = parameters.SecondValue;
        StopAnimation();
        animate = false;
        await Apply();
    }

    private static (string First, string FirstValue, string Second, string SecondValue) Parameters(string name)
    {
        switch (name)
        {
            case "Buffer": return ("Distance (meters)", "1000", null, null);
            case "Simplify": return ("Tolerance (meters)", "500", null, null);
            case "Rotate": return ("Degrees", "90", null, null);
            case "Scale": return ("Percentage", "50", null, null);
            case "Translate": return ("X offset (meters)", "3000", "Y offset (meters)", "3000");
            default: return (null, null, null, null);
        }
    }

    private async Task Merge(bool together)
    {
        merged = together;
        await Apply();
    }

    private async Task Apply()
    {
        Compute();
        await overlay.RedrawAsync();
    }

    private void Compute()
    {
        var shape = pieces[0].GetShape();
        var union = operation == "Union of all the pieces";
        var paired = operation == "Intersection with the blue area" || operation == "Difference from the blue area";
        BaseShape result;
        switch (operation)
        {
            case "Buffer": result = shape.Buffer(Number(first, 1000), GeographyUnit.Meter, DistanceUnit.Meter); break;
            case "Simplify": result = AreaBaseShape.Simplify((AreaBaseShape)shape, Number(first, 500), SimplificationType.DouglasPeucker); break;
            case "Rotate": result = BaseShape.Rotate(shape, shape.GetCenterPoint(), (float)Number(first, 90)); break;
            case "Scale": result = BaseShape.ScaleTo(shape, Number(first, 50) / 100.0); break;
            case "Translate": result = BaseShape.TranslateByOffset(shape, Number(first, 3000), Number(second, 3000), GeographyUnit.Meter, DistanceUnit.Meter); break;
            case "Convex hull": result = pieces[0].GetConvexHull().GetShape(); break;
            case "Envelope": result = shape.GetBoundingBox(); break;
            case "Intersection with the blue area": result = ((AreaBaseShape)shape).GetIntersection(westRegion); break;
            case "Difference from the blue area": result = ((AreaBaseShape)shape).GetDifference(westRegion); break;
            default: result = merged ? AreaBaseShape.Union(pieces) : null; break;
        }

        source.InternalFeatures.Clear();
        if (union && !merged)
        {
            for (var i = 0; i < pieces.Count; i++)
            {
                source.InternalFeatures.Add(new Feature(pieces[i].GetShape(), new Dictionary<string, string> { ["color"] = PieceColors[i % PieceColors.Length] }));
            }
        }
        else if (!union)
        {
            source.InternalFeatures.Add(new Feature(shape, new Dictionary<string, string> { ["color"] = PieceColors[0] }));
        }

        region.InternalFeatures.Clear();
        if (paired) region.InternalFeatures.Add(new Feature(westRegion));

        outcome.InternalFeatures.Clear();
        if (result != null) outcome.InternalFeatures.Add(new Feature(result));

        if (union)
        {
            unionNote = merged
                ? pieces.Count + " shapes became " + Polygons(result) + " - one color, one outline"
                : pieces.Count + " separate shapes, each its own color";
        }
    }

    private static int Polygons(BaseShape shape) => shape is MultipolygonShape multipolygon ? multipolygon.Polygons.Count : shape == null ? 0 : 1;

    private void ToggleAnimation(ChangeEventArgs args)
    {
        animate = (bool)args.Value;
        StopAnimation();
        if (animate)
        {
            animation = new CancellationTokenSource();
            _ = AnimateAsync(animation.Token);
        }
    }

    // The parameter sweeps its range and the result follows, one redraw per frame.
    private async Task AnimateAsync(CancellationToken cancellation)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(60));
            while (await timer.WaitForNextTickAsync(cancellation))
            {
                var (from, to, wraps) = Sweep();
                phase = (phase + 0.012) % 1.0;
                var travel = wraps ? phase : 1 - Math.Abs((2 * phase) - 1);
                first = (from + ((to - from) * travel)).ToString("0", CultureInfo.InvariantCulture);
                await Apply();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private (double From, double To, bool Wraps) Sweep()
    {
        switch (operation)
        {
            case "Buffer": return (100, 4000, false);
            case "Simplify": return (0, 4000, false);
            case "Rotate": return (0, 360, true);
            case "Scale": return (20, 200, false);
            default: return (-6000, 6000, false);
        }
    }

    private void StopAnimation()
    {
        animation?.Cancel();
        animation = null;
    }

    private static double Number(string text, double fallback)
        => double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) ? value : fallback;

    public void Dispose() => StopAnimation();
}
