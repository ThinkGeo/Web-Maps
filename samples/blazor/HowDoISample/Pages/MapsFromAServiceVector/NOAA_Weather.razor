@page "/noaa-weather"
@rendermode InteractiveServer
@using ThinkGeo.Core
@using System.Text.Json.Nodes
@implements IDisposable

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@InitialCenter" Zoom="InitialZoom" Bearing="0" Pitch="0">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay @key="mode" Id="@OverlayId" StyleJson="@applied" FeatureSources="@sources" SourceId="features" />
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@InitialCenter" CenterButtonZoom="InitialZoom"
                                    CenterButtonBearing="0" CenterButtonPitch="0" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@InitialCenter" Zoom="InitialZoom" Bearing="0" Pitch="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
        <VectorSourceLoadingIndicator @key="mode" MapId="map" SourceId="@(OverlayId + "::features")" Label="@LoadingLabel" />
    </div>
    <div style="width:320px;flex:0 0 320px;box-sizing:border-box;margin-left:10px;background:dimgray;color:whitesmoke;font:13px system-ui;display:flex;flex-direction:column;min-height:0">
        <div style="padding:8px;font-size:16px;font-weight:600">NOAA Weather</div>
        <div style="padding:0 8px 8px;display:flex;flex-direction:column;gap:6px">
            <label><input type="radio" name="noaa-mode" checked="@(mode == "stations")" @onchange='() => Choose("stations")' /> Weather stations</label>
            <label><input type="radio" name="noaa-mode" checked="@(mode == "warnings")" @onchange='() => Choose("warnings")' /> Weather warnings</label>
        </div>
        <div style="padding:0 8px 7px;font-size:12px;line-height:1.35">@Description</div>
        <div style="padding:0 8px 4px;font-weight:600">style.json - edit it; the map follows</div>
        <textarea @bind="styleJson" @bind:event="oninput" @bind:after="EditorChanged" spellcheck="false" wrap="soft"
                  aria-label="style.json editor"
                  style="flex:1;min-height:0;width:100%;box-sizing:border-box;background:#fff;color:#222;font:11.5px Consolas,monospace;padding:6px;border:0;border-top:1px solid #ccc;resize:none;white-space:pre-wrap;overflow-wrap:anywhere"></textarea>
        <div style="padding:4px 8px 6px;color:@(ok ? "#c9f5d2" : "#ffd0d0")">@status</div>
    </div>
</div>

@code {
    private static readonly PointShape InitialCenter = new PointShape(-10807050, 5045070);
    private const int InitialZoom = 4;

    private const string StyleJson = @"{
  ""layers"": [
    { ""type"": ""circle"",
      ""source-layer"": ""stations"",
      ""paint"": {
          ""circle-radius"": 4.5,
          ""circle-color"": [""step"", [""to-number"", [""get"", ""Temperature""]],
              ""rgba(69,117,180,1)"",
              32, ""rgba(145,191,219,1)"",
              50, ""rgba(255,255,191,1)"",
              70, ""rgba(252,141,89,1)"",
              85, ""rgba(215,48,39,1)""],
          ""circle-stroke-color"": ""rgba(255,255,255,1)"",
          ""circle-stroke-width"": 1.5 }
    },

    { ""type"": ""symbol"",
      ""source-layer"": ""stations"",
      ""minzoom"": 7,
      ""layout"": {
          ""text-field"": [""concat"", [""get"", ""Temperature""], ""°""],
          ""text-font"": [""Noto Sans Bold""],
          ""text-size"": 10,
          ""text-offset"": [0, 1.1] },
      ""paint"": {
          ""text-color"": ""#333333"",
          ""text-halo-color"": ""#FFFFFF"",
          ""text-halo-width"": 1 }
    }
  ]
}";

    private const string WarningsStyleJson = @"{
  ""layers"": [
    { ""type"": ""fill"",
      ""source-layer"": ""warnings"",
      ""paint"": {
          ""fill-color"": [""match"", [""get"", ""SEVERITY""],
              ""Extreme"", ""rgba(215,25,28,0.40)"",
              ""Severe"", ""rgba(244,109,67,0.40)"",
              ""Moderate"", ""rgba(253,174,97,0.35)"",
              ""Minor"", ""rgba(171,217,233,0.35)"",
              ""rgba(150,150,150,0.30)""] }
    },

    { ""type"": ""line"",
      ""source-layer"": ""warnings"",
      ""paint"": {
          ""line-color"": [""match"", [""get"", ""SEVERITY""],
              ""Extreme"", ""rgba(215,25,28,1)"",
              ""Severe"", ""rgba(244,109,67,1)"",
              ""Moderate"", ""rgba(253,174,97,1)"",
              ""Minor"", ""rgba(171,217,233,1)"",
              ""rgba(150,150,150,1)""],
          ""line-width"": 1.5 }
    },

    { ""type"": ""symbol"",
      ""source-layer"": ""warnings"",
      ""layout"": {
          ""text-field"": [""get"", ""EVENT""],
          ""text-font"": [""Noto Sans Bold""],
          ""text-size"": 11,
          ""text-max-width"": 16 },
      ""paint"": {
          ""text-color"": ""rgba(60,60,60,1)"",
          ""text-halo-color"": ""rgba(255,255,255,1)"",
          ""text-halo-width"": 1.5 }
    }
  ]
}";

    private string mode = "stations";
    private bool disposed;
    private readonly Dictionary<string, string> documents = new();
    private string OverlayId => mode == "stations" ? "WeatherStations" : "WeatherWarnings";
    private string LoadingLabel => mode == "stations" ? "Loading NOAA weather stations..." : "Loading NOAA weather warnings...";
    private string Description => mode == "stations"
        ? "Live weather stations, colored by temperature. Zoom in to see temperature labels."
        : "Active weather warnings, colored by severity and labeled by event. On a quiet day there may be few.";

    private MapView map;
    private GeoCollection<FeatureSource> sources;
    private string styleJson = StyleJson;
    private string applied = StyleJson;
    private string status = "";
    private bool ok = true;
    private int edit;

    protected override void OnInitialized() => SetSources();

    private void Choose(string selected)
    {
        if (mode == selected) return;
        documents[mode] = applied;
        ++edit;
        mode = selected;
        styleJson = applied = documents.TryGetValue(mode, out var saved)
            ? saved : mode == "stations" ? StyleJson : WarningsStyleJson;
        status = "";
        ok = true;
        SetSources();
    }

    private void SetSources()
    {
        FeatureSource source = mode == "stations"
            ? new NoaaWeatherStationFeatureSource { ProjectionConverter = new ProjectionConverter(4326, 3857) }
            : new NoaaWeatherWarningsFeatureSource { ProjectionConverter = new ProjectionConverter(4326, 3857) };
        sources = new GeoCollection<FeatureSource> { { mode, source } };
    }

    // A document that does not parse changes nothing; the map keeps the last one that did.
    private async Task EditorChanged()
    {
        var mine = ++edit;
        await Task.Delay(400);
        if (mine != edit || disposed) return;

        try
        {
            if (JsonNode.Parse(styleJson) is not JsonObject document || document["layers"] is not JsonArray)
                throw new FormatException("The style needs a layers array.");
            applied = styleJson;
            ok = true;
            status = $"applied at {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception exception)
        {
            ok = false;
            status = "not applied - " + exception.Message.Split('\n')[0].TrimEnd('\r');
        }
    }
    public void Dispose() { disposed = true; ++edit; }
}

