<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmLinkIcalls>false</WasmLinkIcalls>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.21" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.154.0" />
    <PackageReference Include="ThinkGeo.UI.Blazor" Version="15.0.0-beta244" />
  </ItemGroup>
</Project>
