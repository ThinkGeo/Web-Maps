@page "/routing"
@rendermode InteractiveServer
@using ThinkGeo.Core
@implements IDisposable

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@InitialCenter" Zoom="InitialZoom" Bearing="0" Pitch="0" OnClick="@Clicked">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Marks" @ref="marks" StyleJson="@MarksStyle" FeatureSources="@sources" SourceId="marks" />
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@InitialCenter" CenterButtonZoom="InitialZoom"
                                    CenterButtonBearing="0" CenterButtonPitch="0" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@InitialCenter" Zoom="InitialZoom" Bearing="0" Pitch="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
        @if (busy)
        {
            <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);padding:10px 16px;border-radius:6px;background:rgba(30,30,30,.85);color:white;font:14px system-ui;pointer-events:none">Routing...</div>
        }
    </div>
    <div style="position:relative;z-index:10000;width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;background:dimgray;color:whitesmoke;font:13px system-ui;display:flex;flex-direction:column;min-height:0">
        <div style="padding:8px;display:flex;flex-direction:column;gap:6px">
            <div style="font-size:17px;line-height:1.25;text-align:center">Make a Turn-By-Turn Routing Request</div>
            <div style="line-height:1.3">Click the map to add a stop and request the route again.</div>
            <button style="@SidebarButtonStyle" @onclick="ResetAsync" disabled="@busy">Start Over</button>
            <div role="status" style="min-height:18px;line-height:1.3">@status</div>
        </div>
        <div style="flex:1;min-height:0;overflow:auto;margin:0 8px 8px;background:#f6f6f4;color:#222;border-top:1px solid #aaa">
            @foreach (var segment in segments)
            {
                <div style="cursor:pointer;padding:6px 4px;border-bottom:1px solid #ccc;background:@(segment == picked ? "#ded2ed" : "transparent")" @onclick="() => PickAsync(segment)">
                    <div style="font-weight:600;overflow-wrap:anywhere">@segment.Instruction</div>
                    <div style="font-size:12px">Distance: @segment.Distance.ToString("0.00") meters</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private const string SidebarButtonStyle = "border:2px solid #8a8a8a;background:#f6f6f4;color:#222;padding:2px 6px;cursor:pointer;font:13px system-ui";
    private static readonly PointShape InitialCenter = new PointShape(-10778720, 3915154);
    private const int InitialZoom = 12;

    private const string MarksStyle = @"{
  ""layers"": [
    { ""type"": ""line"", ""source-layer"": ""route"",
      ""layout"": { ""line-cap"": ""round"", ""line-join"": ""round"" },
      ""paint"": { ""line-color"": ""#9370DB"", ""line-width"": 4 } },
    { ""type"": ""line"", ""source-layer"": ""highlight"",
      ""layout"": { ""line-cap"": ""round"", ""line-join"": ""round"" },
      ""paint"": { ""line-color"": ""#FFD400"", ""line-width"": 8, ""line-opacity"": 0.9 } },
    { ""type"": ""circle"", ""source-layer"": ""stops"",
      ""paint"": { ""circle-radius"": 7, ""circle-color"": ""#6A3DB8"", ""circle-stroke-color"": ""#FFFFFF"", ""circle-stroke-width"": 2 } },
    { ""type"": ""symbol"", ""source-layer"": ""stops"",
      ""layout"": { ""text-field"": [""get"", ""label""], ""text-font"": [""Noto Sans Bold""], ""text-size"": 12, ""text-offset"": [0, -1.3], ""text-anchor"": ""bottom"", ""text-allow-overlap"": true },
      ""paint"": { ""text-color"": ""#3A1F70"", ""text-halo-color"": ""#FFFFFF"", ""text-halo-width"": 1.5 } }
  ]
}";

    private static readonly PointShape[] FirstStops =
    {
        new PointShape(-10776986.85, 3908680.24),
        new PointShape(-10776836.12, 3912348.04),
        new PointShape(-10778917.01, 3909965.17),
        new PointShape(-10779631.80, 3915721.82),
    };

    private MapView map;
    private VectorTileOverlay marks;
    private GeoCollection<FeatureSource> sources;
    private readonly InMemoryFeatureSource route = new InMemoryFeatureSource();
    private readonly InMemoryFeatureSource highlight = new InMemoryFeatureSource();
    private readonly InMemoryFeatureSource stops = new InMemoryFeatureSource(new[] { new FeatureSourceColumn("label") }, Array.Empty<Feature>());
    private readonly List<PointShape> waypoints = new List<PointShape>(FirstStops);
    private RoutingCloudClient client;
    private bool busy;
    private bool disposed;
    private string status = "Loading the preset route...";
    private List<CloudRoutingSegment> segments = new List<CloudRoutingSegment>();
    private CloudRoutingSegment picked;

    protected override void OnInitialized()
    {
        sources = new GeoCollection<FeatureSource> { { "route", route }, { "highlight", highlight }, { "stops", stops } };
        client = new RoutingCloudClient(GlobalSettings.ThinkGeoCloudClientId, GlobalSettings.ThinkGeoCloudClientSecret);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RouteAsync();
    }

    public void Dispose()
    {
        disposed = true;
        client?.Dispose();
    }

    private async Task Clicked(ClickedMapViewEventArgs args)
    {
        if (busy || disposed || waypoints.Count >= 12) return;
        waypoints.Add(new PointShape(args.WorldX, args.WorldY));
        await RouteAsync();
    }

    private async Task ResetAsync()
    {
        if (busy || disposed) return;
        waypoints.Clear();
        waypoints.AddRange(FirstStops);
        await RouteAsync();
    }

    private async Task RouteAsync()
    {
        if (busy || disposed) return;
        busy = true;
        status = "Routing...";
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await client.GetRouteAsync(waypoints, 3857, new CloudRoutingGetRouteOptions { TurnByTurn = true });
            if (disposed) return;
            if (result.Exception != null)
            {
                status = result.Exception.Message;
                return;
            }
            if (result.RouteResult?.Routes == null || result.RouteResult.Routes.Count == 0)
            {
                status = "No route was found for these stops.";
                return;
            }

            segments = result.RouteResult.Routes.SelectMany(part => (IEnumerable<CloudRoutingSegment>)part.Segments ?? Enumerable.Empty<CloudRoutingSegment>()).ToList();
            picked = null;
            route.InternalFeatures.Clear();
            foreach (var part in result.RouteResult.Routes)
            {
                route.InternalFeatures.Add(new Feature(part.Shape));
            }
            stops.InternalFeatures.Clear();
            var index = 0;
            foreach (var waypoint in result.RouteResult.Waypoints)
            {
                var label = index == 0 ? "Start" : index == result.RouteResult.Waypoints.Count - 1 ? "End" : "Stop " + index;
                stops.InternalFeatures.Add(new Feature(new PointShape(waypoint.Coordinate), new Dictionary<string, string> { ["label"] = label }));
                index++;
            }
            highlight.InternalFeatures.Clear();
            await marks.RedrawAsync();

            var length = result.RouteResult.Routes.Sum(part => part.Distance) / 1000;
            var time = TimeSpan.FromSeconds(result.RouteResult.Routes.Sum(part => part.Duration.TotalSeconds));
            status = $"{waypoints.Count} stops, {length:0.0} km, {time:h\\:mm\\:ss}; {segments.Count} segments.";

            var bounds = MapUtil.GetBoundingBoxOfItems(result.RouteResult.Routes.Select(part => part.Shape));
            bounds.ScaleUp(20);
            await map.ZoomToExtentAsync(bounds);
        }
        catch (Exception exception)
        {
            if (!disposed) status = exception.Message;
        }
        finally
        {
            busy = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PickAsync(CloudRoutingSegment segment)
    {
        if (busy || disposed) return;
        try
        {
            picked = segment;
            highlight.InternalFeatures.Clear();
            highlight.InternalFeatures.Add(new Feature(segment.Shape));
            await marks.RedrawAsync();

            var bounds = segment.Shape.GetBoundingBox();
            bounds.ScaleUp(60);
            if (bounds.Width < 400 || bounds.Height < 400)
            {
                bounds = new RectangleShape(bounds.GetCenterPoint().X - 200, bounds.GetCenterPoint().Y + 200, bounds.GetCenterPoint().X + 200, bounds.GetCenterPoint().Y - 200);
            }
            await map.ZoomToExtentAsync(bounds);
        }
        catch (Exception exception)
        {
            if (!disposed) status = exception.Message;
        }
    }
}
