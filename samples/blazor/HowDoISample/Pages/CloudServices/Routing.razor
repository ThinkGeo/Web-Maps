@page "/routing"
@rendermode InteractiveServer
@using ThinkGeo.Core
@using System.Globalization
@implements IDisposable

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@InitialCenter" Zoom="InitialZoom" Bearing="0" Pitch="0" OnClick="@Clicked">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Marks" @ref="marks" StyleJson="@CurrentStyle" FeatureSources="@sources" SourceId="marks" />
            </OverlaysSetting>
            <MarkerOverlaySetting>
                <SimpleMarkerOverlay Id="ServiceAreaCenter" @ref="centerMarkers" />
            </MarkerOverlaySetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@InitialCenter" CenterButtonZoom="InitialZoom"
                                    CenterButtonBearing="0" CenterButtonPitch="0" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@InitialCenter" Zoom="InitialZoom" Bearing="0" Pitch="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
        @if (busy)
        {
            <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);padding:10px 16px;border-radius:6px;background:rgba(30,30,30,.85);color:white;font:14px system-ui;pointer-events:none">@(mode == "area" ? "Calculating service area..." : mode == "optimized" ? "Optimizing route..." : "Routing...")</div>
        }
    </div>
    <div style="position:relative;z-index:10000;width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;background:dimgray;color:whitesmoke;font:13px system-ui;display:flex;flex-direction:column;min-height:0">
        <div style="padding:8px;display:flex;flex-direction:column;gap:6px">
            <div style="font-size:17px;font-weight:600">Routing</div>
            @foreach (var choice in Modes)
            {
                <label><input type="radio" name="routing-mode" checked="@(mode == choice.Key)" disabled="@busy" @onchange="() => ChangeModeAsync(choice.Key)" /> @choice.Value</label>
            }
            <div style="line-height:1.3">@Hint</div>
            @if (mode == "area")
            {
                <div style="font-weight:600">Travel times</div>
                @foreach (var (minutes, color) in Bands)
                {
                    <div><span style="display:inline-block;width:14px;height:10px;background:@color;border:1px solid #888"></span> &lt;@minutes minutes</div>
                }
            }
            <button style="@SidebarButtonStyle" @onclick="ResetAsync" disabled="@busy">Start Over</button>
            <div role="status" style="min-height:18px;line-height:1.3">@status</div>
        </div>
        <div style="flex:1;min-height:0;overflow:auto;margin:0 8px 8px;background:#f6f6f4;color:#222;border-top:1px solid #aaa">
            @foreach (var segment in segments)
            {
                <div style="cursor:pointer;padding:6px 4px;border-bottom:1px solid #ccc;background:@(segment == picked ? "#ded2ed" : "transparent")" @onclick="() => PickAsync(segment)">
                    <div style="font-weight:600;overflow-wrap:anywhere">@segment.Instruction</div>
                    <div style="font-size:12px">Distance: @segment.Distance.ToString("0.00") meters</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private const string SidebarButtonStyle = "border:2px solid #8a8a8a;background:#f6f6f4;color:#222;padding:2px 6px;cursor:pointer;font:13px system-ui";
    // Markers are constructed here as in the standalone service-area sample.
#pragma warning disable BL0005
    private static readonly PointShape InitialCenter = new PointShape(-10778720, 3915154);
    private const int InitialZoom = 12;

    private const string MarksStyle = @"{
  ""layers"": [
    { ""type"": ""line"", ""source-layer"": ""route"",
      ""layout"": { ""line-cap"": ""round"", ""line-join"": ""round"" },
      ""paint"": { ""line-color"": ""#9370DB"", ""line-width"": 4 } },
    { ""type"": ""line"", ""source-layer"": ""highlight"",
      ""layout"": { ""line-cap"": ""round"", ""line-join"": ""round"" },
      ""paint"": { ""line-color"": ""#FFD400"", ""line-width"": 8, ""line-opacity"": 0.9 } },
    { ""type"": ""circle"", ""source-layer"": ""stops"",
      ""paint"": { ""circle-radius"": 7, ""circle-color"": ""#6A3DB8"", ""circle-stroke-color"": ""#FFFFFF"", ""circle-stroke-width"": 2 } },
    { ""type"": ""symbol"", ""source-layer"": ""stops"",
      ""layout"": { ""text-field"": [""get"", ""label""], ""text-font"": [""Noto Sans Bold""], ""text-size"": 12, ""text-offset"": [0, -1.3], ""text-anchor"": ""bottom"", ""text-allow-overlap"": true },
      ""paint"": { ""text-color"": ""#3A1F70"", ""text-halo-color"": ""#FFFFFF"", ""text-halo-width"": 1.5 } }
  ]
}";

    private static readonly PointShape[] FirstStops =
    {
        new PointShape(-10776986.85, 3908680.24),
        new PointShape(-10776836.12, 3912348.04),
        new PointShape(-10778917.01, 3909965.17),
        new PointShape(-10779631.80, 3915721.82),
        new PointShape(-10774900.61, 3912552.36),
    };

    private const string OptimizedStyle = @"{
  ""layers"": [
    { ""type"": ""line"", ""source-layer"": ""route"",
      ""layout"": { ""line-cap"": ""round"", ""line-join"": ""round"" },
      ""paint"": { ""line-color"": ""#9370DB"", ""line-width"": 4 } },
    { ""type"": ""line"", ""source-layer"": ""highlight"",
      ""layout"": { ""line-cap"": ""round"", ""line-join"": ""round"" },
      ""paint"": { ""line-color"": ""#FFD400"", ""line-width"": 8, ""line-opacity"": 0.9 } },
    { ""type"": ""circle"", ""source-layer"": ""stops"",
      ""paint"": { ""circle-radius"": 10, ""circle-color"": ""#6A3DB8"", ""circle-stroke-color"": ""#FFFFFF"", ""circle-stroke-width"": 2 } },
    { ""type"": ""symbol"", ""source-layer"": ""stops"",
      ""layout"": { ""text-field"": [""get"", ""order""], ""text-font"": [""Noto Sans Bold""], ""text-size"": 11, ""text-allow-overlap"": true },
      ""paint"": { ""text-color"": ""#FFFFFF"" } },
    { ""type"": ""symbol"", ""source-layer"": ""stops"",
      ""layout"": { ""text-field"": [""get"", ""label""], ""text-font"": [""Noto Sans Bold""], ""text-size"": 12, ""text-offset"": [0, -1.5], ""text-anchor"": ""bottom"", ""text-allow-overlap"": true },
      ""paint"": { ""text-color"": ""#3A1F70"", ""text-halo-color"": ""#FFFFFF"", ""text-halo-width"": 1.5 } }
  ]
}";
    private const string AreaStyle = @"{
  ""layers"": [
    { ""type"": ""fill"", ""source-layer"": ""areas"",
      ""layout"": { ""fill-sort-key"": [""-"", 100, [""to-number"", [""get"", ""minutes""]]] },
      ""paint"": {
          ""fill-color"": [""match"", [""get"", ""minutes""],
              ""15"", ""rgba(46,160,67,0.45)"",
              ""30"", ""rgba(240,200,40,0.45)"",
              ""45"", ""rgba(240,140,30,0.45)"",
              ""rgba(210,50,40,0.45)""],
          ""fill-outline-color"": ""rgba(60,60,60,0.6)"" } }
  ]
}";
    private static readonly Dictionary<string, string> Modes = new()
    {
        ["route"] = "Route in stop order",
        ["optimized"] = "Traveling salesperson",
        ["area"] = "Service area"
    };
    private string mode = "route";
    private string CurrentStyle => mode == "area" ? AreaStyle : mode == "optimized" ? OptimizedStyle : MarksStyle;
    private string Hint => mode == "area"
        ? "Click the map to find the areas reachable in 15, 30, 45 and 60 minutes."
        : mode == "optimized" ? "Click to add a stop (up to 12). Optimize the stop order for a round trip."
        : "Click to add a stop (up to 12). Visit the stops in the order added.";
    private static readonly PointShape InitialSearchPoint = new PointShape(-10776836.14, 3912350.71);
    private PointShape areaPoint = InitialSearchPoint;
    private static readonly PointMarkerStyle CenterMarkerStyle = new PointMarkerStyle("images/routing-service-area-marker.png", 0.5, 1, 1);
    private static readonly (int Minutes, string Color)[] Bands =
    {
        (15, "rgba(46,160,67,0.45)"), (30, "rgba(240,200,40,0.45)"),
        (45, "rgba(240,140,30,0.45)"), (60, "rgba(210,50,40,0.45)")
    };
    private readonly InMemoryFeatureSource areas = new(new[] { new FeatureSourceColumn("minutes") }, Array.Empty<Feature>());
    private SimpleMarkerOverlay centerMarkers;
    private MapView map;
    private VectorTileOverlay marks;
    private GeoCollection<FeatureSource> sources;
    private readonly InMemoryFeatureSource route = new InMemoryFeatureSource();
    private readonly InMemoryFeatureSource highlight = new InMemoryFeatureSource();
    private readonly InMemoryFeatureSource stops = new InMemoryFeatureSource(new[] { new FeatureSourceColumn("label"), new FeatureSourceColumn("order") }, Array.Empty<Feature>());
    private readonly List<PointShape> waypoints = new List<PointShape>(FirstStops);
    private RoutingCloudClient client;
    private bool busy;
    private bool disposed;
    private string status = "Loading the preset route...";
    private List<CloudRoutingSegment> segments = new List<CloudRoutingSegment>();
    private CloudRoutingSegment picked;

    protected override void OnInitialized()
    {
        sources = new GeoCollection<FeatureSource> { { "route", route }, { "highlight", highlight }, { "stops", stops }, { "areas", areas } };
        client = new RoutingCloudClient(GlobalSettings.ThinkGeoCloudClientId, GlobalSettings.ThinkGeoCloudClientSecret);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RouteAsync();
    }

    public void Dispose()
    {
        disposed = true;
        client?.Dispose();
    }

    private async Task Clicked(ClickedMapViewEventArgs args)
    {
        if (busy || disposed) return;
        if (mode == "area") { areaPoint = new PointShape(args.WorldX, args.WorldY); await AskAsync(areaPoint); return; }
        if (waypoints.Count >= 12) { status = "Up to 12 stops are supported. Choose Start Over to reset."; return; }
        waypoints.Add(new PointShape(args.WorldX, args.WorldY));
        await CalculateAsync();
    }

    private async Task ResetAsync()
    {
        if (busy || disposed) return;
        areaPoint = InitialSearchPoint;
        waypoints.Clear();
        waypoints.AddRange(FirstStops);
        await CalculateAsync();
    }

    private async Task RouteAsync()
    {
        if (busy || disposed) return;
        busy = true;
        status = "Routing...";
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await client.GetRouteAsync(waypoints, 3857, new CloudRoutingGetRouteOptions { TurnByTurn = true });
            if (disposed) return;
            if (result.Exception != null)
            {
                status = result.Exception.Message;
                return;
            }
            if (result.RouteResult?.Routes == null || result.RouteResult.Routes.Count == 0)
            {
                status = "No route was found for these stops.";
                return;
            }

            segments = result.RouteResult.Routes.SelectMany(part => (IEnumerable<CloudRoutingSegment>)part.Segments ?? Enumerable.Empty<CloudRoutingSegment>()).ToList();
            picked = null;
            route.InternalFeatures.Clear();
            foreach (var part in result.RouteResult.Routes)
            {
                route.InternalFeatures.Add(new Feature(part.Shape));
            }
            stops.InternalFeatures.Clear();
            var index = 0;
            foreach (var waypoint in result.RouteResult.Waypoints)
            {
                var label = index == 0 ? "Start" : index == result.RouteResult.Waypoints.Count - 1 ? "End" : "Stop " + index;
                stops.InternalFeatures.Add(new Feature(new PointShape(waypoint.Coordinate), new Dictionary<string, string> { ["label"] = label }));
                index++;
            }
            highlight.InternalFeatures.Clear();
            await marks.RedrawAsync();

            var length = result.RouteResult.Routes.Sum(part => part.Distance) / 1000;
            var time = TimeSpan.FromSeconds(result.RouteResult.Routes.Sum(part => part.Duration.TotalSeconds));
            status = $"{waypoints.Count} stops, {length:0.0} km, {time:h\\:mm\\:ss}; {segments.Count} segments.";

            var bounds = MapUtil.GetBoundingBoxOfItems(result.RouteResult.Routes.Select(part => part.Shape));
            bounds.ScaleUp(20);
            await map.ZoomToExtentAsync(bounds);
        }
        catch (Exception exception)
        {
            if (!disposed) status = exception.Message;
        }
        finally
        {
            busy = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PickAsync(CloudRoutingSegment segment)
    {
        if (busy || disposed) return;
        try
        {
            picked = segment;
            highlight.InternalFeatures.Clear();
            highlight.InternalFeatures.Add(new Feature(segment.Shape));
            await marks.RedrawAsync();

            var bounds = segment.Shape.GetBoundingBox();
            bounds.ScaleUp(60);
            if (bounds.Width < 400 || bounds.Height < 400)
            {
                bounds = new RectangleShape(bounds.GetCenterPoint().X - 200, bounds.GetCenterPoint().Y + 200, bounds.GetCenterPoint().X + 200, bounds.GetCenterPoint().Y - 200);
            }
            await map.ZoomToExtentAsync(bounds);
        }
        catch (Exception exception)
        {
            if (!disposed) status = exception.Message;
        }
    }
    private Task CalculateAsync() => mode == "area" ? AskAsync(areaPoint) : mode == "optimized" ? OptimizeAsync() : RouteAsync();

    private async Task ChangeModeAsync(string selected)
    {
        if (busy || disposed || mode == selected) return;
        mode = selected;
        picked = null;
        segments.Clear();
        foreach (var source in new[] { route, highlight, stops, areas }) source.InternalFeatures.Clear();
        centerMarkers.Markers.Clear();
        await centerMarkers.RedrawAsync();
        await marks.RedrawAsync();
        await CalculateAsync();
    }

    private async Task OptimizeAsync()
    {
        if (busy || disposed) return;
        busy = true;
        status = "Optimizing route...";
        await InvokeAsync(StateHasChanged);
        try
        {
            var options = new CloudRoutingOptimizationOptions
            {
                TurnByTurn = true,
                Roundtrip = true,
                Source = CloudRoutingTspFixSourceCoordinate.Any,
                Destination = CloudRoutingTspFixDestinationCoordinate.Any,
            };
            var result = await client.GetOptimizedRouteAsync(waypoints, 3857, options);
            if (disposed) return;
            if (result.Exception != null)
            {
                status = result.Exception.Message;
                return;
            }

            var tsp = result.TspResult;
            if (tsp?.Routes == null || tsp.Routes.Count == 0 || tsp.VisitSequences == null || tsp.VisitSequences.Count == 0)
            {
                status = "No optimized route was found for these stops.";
                return;
            }
            if (tsp.VisitSequences.Any(index => index < 0 || index >= waypoints.Count))
            {
                status = "The optimized route returned an invalid stop order.";
                return;
            }

            segments = tsp.Routes.SelectMany(part => (IEnumerable<CloudRoutingSegment>)part.Segments ?? Enumerable.Empty<CloudRoutingSegment>()).ToList();
            picked = null;
            route.InternalFeatures.Clear();
            foreach (var part in tsp.Routes)
            {
                route.InternalFeatures.Add(new Feature(part.Shape));
            }
            stops.InternalFeatures.Clear();
            for (var order = 0; order < tsp.VisitSequences.Count; order++)
            {
                var index = tsp.VisitSequences[order];
                if (order > 0 && index == tsp.VisitSequences[0] && order == tsp.VisitSequences.Count - 1) break;
                var stop = waypoints[index];
                stops.InternalFeatures.Add(new Feature(stop, new Dictionary<string, string>
                {
                    ["order"] = (order + 1).ToString(),
                    ["label"] = order == 0 ? "Start/End Point" : "Stop " + order,
                }));
            }
            highlight.InternalFeatures.Clear();
            await marks.RedrawAsync();

            var length = tsp.Routes.Sum(part => part.Distance) / 1000;
            status = $"{waypoints.Count} stops in the best order, {length:0.0} km round trip; {segments.Count} segments.";

            var bounds = MapUtil.GetBoundingBoxOfItems(tsp.Routes.Select(part => part.Shape));
            bounds.ScaleUp(20);
            await map.ZoomToExtentAsync(bounds);
        }
        catch (Exception exception)
        {
            if (!disposed) status = exception.Message;
        }
        finally
        {
            busy = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }


    private async Task AskAsync(PointShape point)
    {
        if (busy || disposed) return;
        busy = true;
        status = "Calculating the service area...";
        await InvokeAsync(StateHasChanged);
        try
        {
            var limits = Bands.Select(band => TimeSpan.FromMinutes(band.Minutes)).ToList();
            var result = await client.GetServiceAreaAsync(point, 3857, limits, new CloudRoutingGetServiceAreaOptions { DistanceUnit = DistanceUnit.Meter });
            if (disposed) return;
            if (result.Exception != null)
            {
                status = result.Exception.Message;
                return;
            }
            var polygons = result.ServiceAreaResult?.ServiceAreas;
            if (polygons == null || polygons.Count == 0)
            {
                status = "No service areas were found for this location.";
                return;
            }

            centerMarkers.Markers.Clear();
            centerMarkers.Markers.Add("Service area center", new Marker
            {
                Id = "Service area center",
                Position = new PointShape(result.ServiceAreaResult.Waypoint.Coordinate),
                Style = CenterMarkerStyle,
            });
            areas.InternalFeatures.Clear();
            for (var i = 0; i < polygons.Count && i < Bands.Length; i++)
            {
                areas.InternalFeatures.Add(new Feature(polygons[i], new Dictionary<string, string> { ["minutes"] = Bands[i].Minutes.ToString(CultureInfo.InvariantCulture) }));
            }
            await marks.RedrawAsync();
            await centerMarkers.RedrawAsync();
            status = $"{polygons.Count} service areas around {point.X:0}, {point.Y:0}.";

            var bounds = MapUtil.GetBoundingBoxOfItems(polygons);
            bounds.ScaleUp(10);
            await map.ZoomToExtentAsync(bounds);
        }
        catch (Exception exception)
        {
            if (!disposed) status = exception.Message;
        }
        finally
        {
            busy = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }
}
