<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThinkGeo.UI.WebApi.HowDoI</RootNamespace>
    <AssemblyName>ThinkGeo.UI.WebApi.HowDoI</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Every package of the set is pinned to one beta: the gallery shows what that build of the
       SDK does, and a mixed set would make it unclear which. -->
  <ItemGroup>
    <PackageReference Include="ThinkGeo.Core" Version="15.0.0-beta197" />
    <PackageReference Include="ThinkGeo.UI.WebApi" Version="15.0.0-beta197" />
    <PackageReference Include="ThinkGeo.Gdal" Version="15.0.0-beta197" />
    <PackageReference Include="ThinkGeo.FileGeoDatabase" Version="15.0.0-beta197" />
    <PackageReference Include="ThinkGeo.NauticalCharts" Version="15.0.0-beta197" />
    <PackageReference Include="ThinkGeo.PostgreSql" Version="15.0.0-beta197" />
    <PackageReference Include="ThinkGeo.SqlServer" Version="15.0.0-beta197" />
  </ItemGroup>

  <!-- The sample data is the Blazor gallery's, linked in rather than copied: the two galleries
       show the same files. It is copied next to the binaries on build and publish, and read
       from there (see SampleData). -->
  <ItemGroup>
    <Content Include="..\..\blazor\HowDoISample\Data\**" Exclude="..\..\blazor\HowDoISample\Data\temp\**" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The gallery's own data, by format like the shared folder: a JPEG2000, a MrSID, a WKB file, an S-57 chart, a compass picture. -->
    <Content Include="Data\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The code pane shows each sample's server source beside its page; the .cs files go out
       with the site for it to read. -->
  <Target Name="PublishSampleSources" AfterTargets="Publish">
    <ItemGroup>
      <SampleSource Include="Samples\**\*.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(SampleSource)" DestinationFiles="@(SampleSource->'$(PublishDir)Samples\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
