@inherits LayoutComponentBase
@inject SourceCodeLoader SourceCodeLoader
@inject IJSRuntime JS

<nav class="navbar bg-dark fixed-top">
    <a class="navbar-brand" href="https://thinkgeo.com/"> </a>
    <span class="navbar-text mr-auto">
        <h4>ThinkGeo Web UI for Blazor Samples</h4>
        <h6>Explore the features of ThinkGeo web mapping UI controls for Blazor</h6>
    </span>
    <!-- <button type="button" class="btn fa fa-bars collapsed mr-4" data-toggle="collapse" data-target="" aria-expanded="false">
    </button> -->
    <button class="navbar-toggler collapsed mr-4" type="button" data-toggle="collapse" @onclick="SwithToggleMenu"
            aria-controls="navbarToggleExternalContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="fa fa-bars"></span>
    </button>
    <ul class="navbar-nav">
        <li class="nav-item">
            <a href="https://thinkgeo.com/gis-ui-web" target="_blank" rel="noopener">ThinkGeo UI Web for Blazor</a>
        </li>
        |
        <li class="nav-item">
            <a href="https://community.thinkgeo.com/" target="_blank" rel="noopener">Support</a>
        </li>
        |
        <li class="nav-item">
            <a href="https://wiki.thinkgeo.com/wiki/thinkgeo_web_for_blazor" target="_blank" rel="noopener">Wiki</a>
        </li>
    </ul>
</nav>
<div class="container-fluid">
    <div class="row justify-content-end">
        <div class="sidebar @(collapsedCss)" id="sidebar">
            <NavMenu OnMenuClick="@OnMenuClick" />
        </div>
        <main class="main" id="content">
            @if (currentMenu != null)
            {
                <div id="child-page-title" class="pl-md-0 pl-3">
                    <h1>
                        <span class="title">@currentMenu.Title</span>
                        <a type="button" class="download-sample" target="_blank" href="https://gitlab.com/thinkgeo/public/thinkgeo-web-maps/-/tree/master/samples/blazor" id="download-sample">Download Source</a>
                    </h1>
                    <div class="description-wrap">
                        <p class="sample-description" style="padding-right: 132px;">@currentMenu.Description </p>
                    </div>
                </div>
            }

            <nav class="embed-nav group" id="embed-nav">
                <ul class="code-types">
                    <li id="code-type" class="code-type">
                        <a id="html-link"
                           href="#"
                           class="@(showRazorCode ? "active" : string.Empty)"
                           aria-pressed="@showRazorCode"
                           role="button"
                           title="Show the sample's Razor beside it"
                           @onclick="ToggleRazorCode"
                           @onclick:preventDefault>
                            Razor
                        </a>
                    </li>
                </ul>
            </nav>
            <div id="output" class="@(showRazorCode ? "split" : string.Empty)" style="--code-width:@(codeWidthPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%" data-border-style="thin" data-header="true">
                @if (showRazorCode)
                {
                    <div id="razor-box" class="code-wrap code-box box" role="region" aria-label="Razor">
                        <pre><code class="language-cshtml-razor">@razorCode</code></pre>
                    </div>
                    <div id="splitter" class="splitter" role="separator" aria-orientation="vertical"
                         @onpointerdown="SplitterDown" @onpointermove="SplitterMove" @onpointerup="SplitterUp" @onpointercancel="SplitterUp"></div>
                }
                <div id="result-box" class="code-box active" role="region" aria-label="Result">
                    @Body
                </div>
            </div>
        </main>
    </div>
</div>
<div id="loadingImage">
    <i class="fa fa-spinner fa-spin fa-3x fa-fw"></i>
</div>

@code{
    MenuModel currentMenu;
    string razorCode;
    string collapsedCss = "collapse";
    bool showRazorCode;

    async Task OnMenuClick(MenuModel menu)
    {
        if (currentMenu != menu)
        {
            currentMenu = menu;
            razorCode = await SourceCodeLoader.LoadRazorCodeAsync(menu.Source);
        }
    }

    void SwithToggleMenu()
    {
        collapsedCss = string.IsNullOrEmpty(collapsedCss) ? "collapse" : string.Empty;
    }

    // The code sits beside the sample, the way the desktop gallery lays it out: the sample
    // has the whole width until the code is asked for, and the two share it after, split
    // where the divider is dragged to.
    void ToggleRazorCode()
    {
        showRazorCode = !showRazorCode;
    }

    double codeWidthPercent = 45;
    bool dragging;
    double dragStartX;
    double dragStartPercent;
    ElementReference outputElement;

    async Task SplitterDown(PointerEventArgs e)
    {
        dragging = true;
        dragStartX = e.ClientX;
        dragStartPercent = codeWidthPercent;
        // The output's width as the browser laid it out, so a pixel of drag is the right fraction.
        outputWidth = await JS.InvokeAsync<double>("eval", "document.getElementById('output').getBoundingClientRect().width");
    }

    void SplitterMove(PointerEventArgs e)
    {
        if (!dragging) return;
        // The layout is a percentage of the output's width, which the browser lays out at
        // the window's; a pixel of drag is a fraction of that.
        var deltaPercent = (e.ClientX - dragStartX) / Math.Max(1, outputWidth) * 100;
        codeWidthPercent = Math.Clamp(dragStartPercent + deltaPercent, 15, 85);
    }

    void SplitterUp(PointerEventArgs e)
    {
        dragging = false;
    }

    double outputWidth = 1200;
}
