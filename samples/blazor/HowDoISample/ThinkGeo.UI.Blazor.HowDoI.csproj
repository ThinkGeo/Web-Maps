<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net9.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net9.0</TargetFramework>
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <Content Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <EmbeddedResource Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <None Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.21" />
    <PackageReference Include="ThinkGeo.Gdal" Version="15.0.0-beta214" />
    <PackageReference Include="ThinkGeo.FileGeoDatabase" Version="15.0.0-beta214" />
    <PackageReference Include="ThinkGeo.NauticalCharts" Version="15.0.0-beta214" />
    <PackageReference Include="ThinkGeo.PostgreSql" Version="15.0.0-beta214" />
    <PackageReference Include="ThinkGeo.SqlServer" Version="15.0.0-beta214" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HowDoISample.Client\ThinkGeo.UI.Blazor.HowDoI.Client.csproj" />
    <ProjectReference Include="..\..\..\..\thinkgeosdk\ThinkGeo.UI\Web\ThinkGeo.UI.Blazor\ThinkGeo.UI.Blazor.csproj" />
    <ProjectReference Include="..\..\..\..\thinkgeosdk\ThinkGeo.Core\Extensions\Cad\ThinkGeo.Cad.csproj" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Pages\**\*.razor">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\**" Exclude="Data\temp\**;Data\**\*.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PublishClientRazorSources" AfterTargets="Publish">
    <ItemGroup>
      <ClientRazorSourceFile Include="..\HowDoISample.Client\Pages\**\*.razor" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientRazorSourceFile)" DestinationFolder="$(PublishDir)ClientPages" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishRazorSources" AfterTargets="Publish">
    <ItemGroup>
      <RazorSourceFile Include="Pages\**\*.razor" />
    </ItemGroup>
    <Copy SourceFiles="@(RazorSourceFile)" DestinationFolder="$(PublishDir)Pages" SkipUnchangedFiles="true" />
  </Target>

</Project>
