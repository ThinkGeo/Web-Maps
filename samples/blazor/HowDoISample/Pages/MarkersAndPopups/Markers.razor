@page "/markers"
@rendermode InteractiveServer
@using ThinkGeo.Core
@implements IDisposable

<div class="map-container">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10777290, 3908740))" Zoom="15" Pitch="@pitch"
                 OnClick="@Clicked" OnReady="@MapReadyAsync">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
            </OverlaysSetting>
            <MarkerOverlaySetting>
                <SimpleMarkerOverlay Id="Pins" @ref="pins" OnClick="@PinClicked" />
            </MarkerOverlaySetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@(new PointShape(-10777290, 3908740))" CenterButtonZoom="15" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
    <div style="position:absolute;top:12px;right:12px;width:280px;max-height:calc(100% - 24px);overflow:auto;box-sizing:border-box;padding:10px 12px;background:rgba(30,30,30,.85);color:whitesmoke;font:13px system-ui;border-radius:4px">
        <div style="font-weight:600;margin-bottom:6px">Markers</div>
        <div style="font-weight:600;margin-bottom:6px">Mouse</div>
        <label style="display:block"><input type="radio" name="marker-mode" checked="@(mode == MarkerMode.AddStatic)" @onchange="@(() => mode = MarkerMode.AddStatic)" /> Add a static marker</label>
        <label style="display:block;margin-top:6px"><input type="radio" name="marker-mode" checked="@(mode == MarkerMode.AddAnimated)" @onchange="@(() => mode = MarkerMode.AddAnimated)" /> Add an animated marker</label>
        <label style="display:block;margin-top:6px"><input type="radio" name="marker-mode" checked="@(mode == MarkerMode.Remove)" @onchange="@(() => mode = MarkerMode.Remove)" /> Remove a marker</label>
        <div style="margin-top:6px;color:#e5e5e5">Click the map to add the selected type, or click a marker in remove mode.</div>
        <label style="display:block;margin-top:14px">Tilt: @pitch.ToString("0")°
            <input aria-label="Tilt" type="range" min="0" max="60" step="1" value="@pitch" style="width:100%" @oninput="@(e => pitch = Convert.ToDouble(e.Value))" />
        </label>
        <div style="font-weight:600;margin-top:14px">Animated marker</div>
        <div style="color:#e5e5e5;line-height:1.4;margin-top:6px">The pulsing red dot uses an animated SVG image. Tilt the map to see the markers stay anchored to their places.</div>
        <label style="display:block;margin-top:6px"><input type="checkbox" checked="@animated" @onchange="ToggleAnimationAsync" /> Animate all animated markers</label>
        <div style="display:flex;gap:8px;align-items:center;margin-top:9px">
            <button class="btn btn-sm btn-light" @onclick="ClearAsync">Clear</button>
            <span style="color:#e5e5e5">@count markers</span>
        </div>
    </div>
</div>

@code {
    // Markers made in code: Blazor warns (BL0005) about setting a component's parameters, which is safe here.
#pragma warning disable BL0005
    private MapView map;
    private SimpleMarkerOverlay pins;
    private static readonly PointMarkerStyle Pulsing = new("images/beacon.svg", 0.5, 0.5, 1);
    private static readonly PointMarkerStyle Still = new("images/beacon-still.svg", 0.5, 0.5, 1);
    private enum MarkerMode { AddStatic, AddAnimated, Remove }
    private MarkerMode mode = MarkerMode.AddStatic;
    private readonly HashSet<string> animatedIds = new();
    private bool animated = true;
    private double pitch;
    private int count;
    private int next = 1;
    private bool disposed;

    protected override void OnInitialized()
    {
        // The first marker is in place before the overlay reaches the browser.
        Add(new PointShape(-10777290, 3908740));
        Add(new PointShape(-10776790, 3908990), true);
    }

    private void Add(PointShape position, bool isAnimated = false)
    {
        var marker = new Marker { Id = "Pin " + next++, Position = position };
        if (isAnimated)
        {
            marker.Style = animated ? Pulsing : Still;
            animatedIds.Add(marker.Id);
        }
        // The overlay is the page's own component and is not yet bound the first time.
        (pins?.Markers ?? pending).Add(marker.Id, marker);
        count++;
    }

    private readonly GeoCollection<Marker> pending = new GeoCollection<Marker>();

    private async Task MapReadyAsync()
    {
        foreach (var marker in pending)
        {
            pins.Markers.Add(marker.Id, marker);
        }
        pending.Clear();
        await pins.RedrawAsync();
    }

    private async Task Clicked(ClickedMapViewEventArgs args)
    {
        if (disposed || mode == MarkerMode.Remove) return;
        await map.WhenReady;
        Add(new PointShape(args.WorldX, args.WorldY), mode == MarkerMode.AddAnimated);
        await pins.RedrawAsync();
    }

    private async Task PinClicked(ClickedMarkerOverlayEventArgs args)
    {
        if (disposed || mode != MarkerMode.Remove || !pins.Markers.Contains(args.ClickedMarker.Id)) return;
        pins.Markers.Remove(args.ClickedMarker.Id);
        animatedIds.Remove(args.ClickedMarker.Id);
        count--;
        await pins.RedrawAsync();
    }

    private async Task ToggleAnimationAsync(ChangeEventArgs args)
    {
        animated = (bool)args.Value;
        if (disposed) return;
        await map.WhenReady;
        foreach (var id in animatedIds)
        {
            pins.Markers[id].Style = animated ? Pulsing : Still;
        }
        await pins.RedrawAsync();
    }

    private async Task ClearAsync()
    {
        if (disposed) return;
        await map.WhenReady;
        pins.Markers.Clear();
        animatedIds.Clear();
        count = 0;
        await pins.RedrawAsync();
    }

    public void Dispose()
    {
        disposed = true;
    }
}
