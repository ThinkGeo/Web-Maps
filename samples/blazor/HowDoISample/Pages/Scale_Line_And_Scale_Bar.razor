@page "/scale-line-and-scale-bar"
@using ThinkGeo.Core

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10778000, 3912000))" Zoom="12">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@(new PointShape(-10778000, 3912000))" CenterButtonZoom="12" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@(new PointShape(-10778000, 3912000))" Zoom="12" />
                </MapTools>
            </MapToolsSetting>
            <AdornmentOverlaySetting>
                <AdornmentOverlay Id="Adornments" @ref="adornmentOverlay" Layers="@adornments"
                                  RedrawWhileMoving="true" />
            </AdornmentOverlaySetting>
        </MapView>
    </div>
    <div style="width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;padding:8px;display:flex;flex-direction:column;background:dimgray;color:whitesmoke;font:13px system-ui;min-height:0;overflow:auto">
        <div style="font-size:16px;font-weight:600;margin-bottom:6px">Scale Line and Scale Bar</div>
        <div style="margin-bottom:8px;line-height:1.35">The scale line and scale bar show ground distance in the lower left. Their projection corrects for Web Mercator distortion, and both update as the map zooms.</div>
        <label style="font-weight:700;margin-bottom:4px" for="scale-line-units">Scale line units</label>
            <select id="scale-line-units" @onchange="UnitsChanged" style="width:100%;box-sizing:border-box;margin-bottom:8px;font:13px system-ui">
                <option value="ImperialAndMetric">imperial and metric</option>
                <option value="MetricAndNauticalMile">metric and nautical miles</option>
                <option value="NauticalMileAndImperial">nautical miles and imperial</option>
                <option value="Default">the default</option>
            </select>
        <label style="line-height:1.35"><input type="checkbox" @onchange="TextStylesChanged" /> Custom text styles for ScaleLine</label>
        <div style="font-size:11px;color:#e5e5e5;margin-top:6px;line-height:1.3">Blue italic text above, red text below.</div>
    </div>
</div>

@code {
    private MapView map;
    private AdornmentOverlay adornmentOverlay;
    private GeoCollection<AdornmentLayer> adornments;
    private ScaleLineAdornmentLayer scaleLine;

    protected override void OnInitialized()
    {
        var projection = new Projection(3857);
        scaleLine = new ScaleLineAdornmentLayer
        {
            Projection = projection,
            BackgroundMask = AreaStyle.CreateSimpleAreaStyle(GeoColors.LightBlue, GeoColors.Red),
            UnitSystem = ScaleLineUnitSystem.ImperialAndMetric,
        };
        var scaleBar = new ScaleBarAdornmentLayer
        {
            YOffsetInPixel = -50,
            Projection = projection,
            BackgroundMask = AreaStyle.CreateSimpleAreaStyle(GeoColors.LightBlue, GeoColors.Red),
        };
        adornments = new GeoCollection<AdornmentLayer> { { "line", scaleLine }, { "bar", scaleBar } };
    }

    private Task UnitsChanged(ChangeEventArgs args)
    {
        scaleLine.UnitSystem = Enum.Parse<ScaleLineUnitSystem>((string)args.Value);
        return adornmentOverlay.RedrawAsync();
    }

    private Task TextStylesChanged(ChangeEventArgs args)
    {
        if ((bool)args.Value)
        {
            scaleLine.AboveLabelTextStyle = new TextStyle(string.Empty, new GeoFont("Arial", 16, DrawingFontStyles.Italic), GeoBrushes.Blue) { TextPlacement = TextPlacement.Left, YOffsetInPixel = -2 };
            scaleLine.BelowLabelTextStyle = new TextStyle(string.Empty, new GeoFont("Arial", 16), GeoBrushes.Red) { TextPlacement = TextPlacement.Left, YOffsetInPixel = 2 };
        }
        else
        {
            scaleLine.AboveLabelTextStyle = null;
            scaleLine.BelowLabelTextStyle = null;
        }
        return adornmentOverlay.RedrawAsync();
    }
}
