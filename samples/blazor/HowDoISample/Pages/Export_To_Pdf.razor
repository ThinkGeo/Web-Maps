@page "/export-to-pdf"
@using ThinkGeo.Core
@using System.IO
@using System.Threading
@using System.Collections.ObjectModel
@using ThinkGeo.UI.Blazor.HowDoI.Shared

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10777700, 3912400))" Zoom="12"
                 OnCurrentExtentChanged="@(args => extent = args.CurrentExtent)">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Zoning" StyleJson="@StyleJson" FeatureSources="@sources" SourceId="features" />
            </OverlaysSetting>
        </MapView>
    </div>
    <div style="width:420px;display:flex;flex-direction:column;gap:8px;padding:10px;background:#f6f6f4;border-left:1px solid #ccc;font:13px system-ui">
        <div style="font-weight:600">Export to PDF</div>
        <div style="color:#555">Two ways onto a page. <b>Raster</b>: the map exactly as the browser draws it comes back as a picture, through MapView.GetImageAsync, and is placed on the page - pixels. <b>Vector</b>: the extent is drawn again on the server into a PdfGeoCanvas - the ThinkGeo Cloud vector tiles styled by MvtTilesAsyncLayer, the zoning from its shapefile, the title and footer as text - so every road, parcel and label is a path or a glyph that prints sharp at any size. Either page is kept on the server for a few minutes and fetched from export/{id}.</div>
        <input @bind="title" style="font:13px system-ui;padding:3px 6px" />
        <div style="display:flex;gap:8px;align-items:center">
            <button class="btn btn-sm btn-primary" @onclick="PrintRasterAsync" disabled="@busy">Print as raster</button>
            <button class="btn btn-sm btn-primary" @onclick="PrintVectorAsync" disabled="@busy">Print as vector</button>
        </div>
        <div style="color:#555">@status</div>
        @if (pdfUrl != null)
        {
            <a class="btn btn-sm btn-light" style="align-self:flex-start" download="@fileName" href="@pdfUrl">Save @fileName</a>
            <iframe src="@pdfUrl" style="flex:1;min-height:300px;border:1px solid #ccc;background:#fff"></iframe>
        }
    </div>
</div>

@code {
    private const string StyleJson = @"{
  ""layers"": [
    { ""type"": ""fill"", ""source-layer"": ""zoning"", ""paint"": { ""fill-color"": ""rgba(147,112,219,0.2)"", ""fill-outline-color"": ""#9370DB"" } }
  ]
}";

    // A landscape letter page, in points.
    private const float PageWidth = 792;
    private const float PageHeight = 612;

    private MapView map;
    private GeoCollection<FeatureSource> sources;
    private RectangleShape extent;
    private string title = "Frisco zoning";
    private bool busy;
    private string status = "";
    private string pdfUrl;
    private string fileName;

    protected override void OnInitialized()
    {
        sources = new GeoCollection<FeatureSource>
        {
            { "zoning", new ShapeFileFeatureSource("./Data/Shapefile/Zoning.shp") { ProjectionConverter = new ProjectionConverter(2276, 3857) } }
        };
    }

    // The browser's picture of the map, fitted onto the page between the title and the footer.
    private async Task PrintRasterAsync()
    {
        if (extent == null) return;
        busy = true;
        status = "reading the map...";
        try
        {
            var picture = new GeoImage(await map.GetImageAsync());
            using var stream = new MemoryStream();
            var canvas = new PdfGeoCanvas { PageWidth = PageWidth, PageHeight = PageHeight };
            canvas.BeginDrawing(stream, new RectangleShape(0, PageHeight, PageWidth, 0), GeographyUnit.Meter);
            var scale = Math.Min((PageWidth - 40) / picture.Width, (PageHeight - 90) / picture.Height);
            var width = picture.Width * scale;
            var height = picture.Height * scale;
            canvas.DrawScreenImage(picture, PageWidth / 2, 54 + (height / 2), width, height, DrawingLevel.LevelOne, 0, 0, 0);
            Frame(canvas);
            canvas.EndDrawing();
            Publish(stream, "raster", "frisco-map-raster.pdf");
        }
        catch (Exception exception)
        {
            status = exception.Message;
        }
        busy = false;
    }

    // The same extent drawn on the server: the vector tiles' features, styled, straight onto the
    // page as paths and text, and the zoning over them.
    private async Task PrintVectorAsync()
    {
        if (extent == null) return;
        busy = true;
        status = "drawing...";
        try
        {
            var basemap = new MvtTilesAsyncLayer(ThinkGeoVectorStyles.Light) { TimeoutInSeconds = 60 };
            // The style's tiles are asked for with a {key} placeholder in their address.
            basemap.SendingHttpRequest += (_, args) =>
            {
                var address = args.HttpRequestMessage.RequestUri.ToString().Replace("{key}", GlobalSettings.ThinkGeoApiKey).Replace("%7Bkey%7D", GlobalSettings.ThinkGeoApiKey);
                args.HttpRequestMessage.RequestUri = new Uri(address);
            };
            await basemap.OpenAsync();

            var zoning = new ShapeFileFeatureLayer("./Data/Shapefile/Zoning.shp") { FeatureSource = { ProjectionConverter = new ProjectionConverter(2276, 3857) } };
            zoning.ZoomLevelSet.ZoomLevel01.DefaultAreaStyle = new AreaStyle(new GeoPen(GeoColor.FromHtml("#9370DB"), 1), new GeoSolidBrush(GeoColor.FromArgb(50, 147, 112, 219)));
            zoning.ZoomLevelSet.ZoomLevel01.ApplyUntilZoomLevel = ApplyUntilZoomLevel.Level20;
            zoning.Open();

            // The page shows what the browser shows, widened or heightened to the page's shape.
            var pageExtent = MapUtil.GetDrawingExtent(extent, PageWidth, PageHeight);
            var pageScale = MapUtil.GetScale(GeographyUnit.Meter, pageExtent, PageWidth, PageHeight);
            var features = await basemap.GetFeaturesInsideBoundingBoxAsync(pageExtent, pageScale, CancellationToken.None);

            using var stream = new MemoryStream();
            var canvas = new PdfGeoCanvas { PageWidth = PageWidth, PageHeight = PageHeight };
            canvas.BeginDrawing(stream, pageExtent, GeographyUnit.Meter);
            var labels = new Collection<SimpleCandidate>();
            basemap.Draw(canvas, features, labels);
            canvas.Flush();
            zoning.Draw(canvas, labels);
            canvas.Flush();
            Frame(canvas);
            canvas.EndDrawing();
            zoning.Close();
            await basemap.CloseAsync();
            Publish(stream, "vector", "frisco-map-vector.pdf");
        }
        catch (Exception exception)
        {
            status = exception.Message;
        }
        busy = false;
    }

    // A title band across the top and a footer across the bottom, over whatever the page holds.
    private void Frame(GeoCanvas canvas)
    {
        Band(canvas, 0, 44);
        canvas.DrawTextWithScreenCoordinate(title, new GeoFont("Arial", 20, DrawingFontStyles.Bold), GeoBrushes.Black, PageWidth / 2, 24, DrawingLevel.LevelFour);
        Band(canvas, PageHeight - 26, PageHeight);
        var centre = ProjectionConverter.Convert(3857, 4326, extent.GetCenterPoint());
        var footer = FormattableString.Invariant($"Centre {centre.Y:0.0000}, {centre.X:0.0000}   -   {extent.Width / 1000:0.0} km across   -   {DateTime.Now:yyyy-MM-dd HH:mm}");
        canvas.DrawTextWithScreenCoordinate(footer, new GeoFont("Arial", 9), GeoBrushes.DimGray, PageWidth / 2, PageHeight - 12, DrawingLevel.LevelFour);
    }

    private static void Band(GeoCanvas canvas, float top, float bottom)
    {
        var corners = new[] { new ScreenPointF(0, top), new ScreenPointF(PageWidth, top), new ScreenPointF(PageWidth, bottom), new ScreenPointF(0, bottom), new ScreenPointF(0, top) };
        canvas.DrawArea(new[] { corners }, null, new GeoSolidBrush(GeoColor.FromArgb(225, GeoColors.White)), DrawingLevel.LevelFour, 0, 0, PenBrushDrawingOrder.BrushFirst);
    }

    private void Publish(MemoryStream stream, string kind, string name)
    {
        fileName = name;
        pdfUrl = "export/" + ExportStore.Put(stream.ToArray(), "application/pdf");
        status = $"{stream.Length / 1024} KB, one page, {kind}.";
    }
}
