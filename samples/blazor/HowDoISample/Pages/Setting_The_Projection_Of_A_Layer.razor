@page "/setting-the-projection-of-a-layer"
@using ThinkGeo.Core
@using System.Text.Json.Nodes

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10778770, 3915250))" Zoom="12">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Zoning" StyleJson="@applied" FeatureSources="@sources" SourceId="features" />
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft"
                                    UseNavigationStyle="true"
                                    CenterButtonCenter="@(new PointShape(-10778770, 3915250))"
                                    CenterButtonZoom="12"
                                    CenterButtonBearing="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
    </div>
    <div style="width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;background:dimgray;color:whitesmoke;font:13px system-ui;display:flex;flex-direction:column;min-height:0">
        <div style="padding:8px 8px 4px;font-size:16px;font-weight:600">style.json - edit it; the map follows</div>
        <div style="padding:0 8px 6px">The shapefile is in Texas state plane feet (EPSG:2276). Its ProjectionConverter says so, and the source hands out every feature in the map's meters - the tiles are cut and the style drawn as if the file had always been Web Mercator.</div>
        <textarea @bind="styleJson" @bind:event="oninput" @bind:after="EditorChanged" spellcheck="false" wrap="soft"
                  aria-label="style.json editor"
                  style="flex:1;min-height:0;width:100%;box-sizing:border-box;background:#fff;color:#222;font:11.5px Consolas,monospace;padding:6px;border:0;border-top:1px solid #ccc;resize:none;white-space:pre-wrap;overflow-wrap:anywhere"></textarea>
        <div style="padding:4px 8px 6px;color:@(ok ? "#c9f5d2" : "#ffd0d0")">@status</div>
    </div>
</div>

@code {
    private const string StyleJson = @"{
  ""layers"": [
    { ""type"": ""fill"",
      ""source-layer"": ""zoning"",
      ""paint"": {
          ""fill-color"": ""rgba(147,112,219,0.2)"",
          ""fill-outline-color"": ""#9370DB"" }
    }
  ]
}";

    private MapView map;
    private GeoCollection<FeatureSource> sources;
    private RectangleShape bounds;
    private string styleJson = StyleJson;
    private string applied = StyleJson;
    private string status = "";
    private bool ok = true;
    private int edit;

    protected override void OnInitialized()
    {
        var zoning = new ShapeFileFeatureSource("./Data/Shapefile/Zoning.shp") { ProjectionConverter = new ProjectionConverter(2276, 3857) };
        sources = new GeoCollection<FeatureSource> { { "zoning", zoning } };

        zoning.Open();
        bounds = zoning.GetBoundingBox();
        zoning.Close();
        bounds.ScaleUp(50);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        for (var attempt = 0; attempt < 80 && map?.IsLoaded != true; attempt++)
        {
            await Task.Delay(250);
        }
        await map.ZoomToExtentAsync(bounds);
    }

    // A document that does not parse changes nothing; the map keeps the last one that did.
    private async Task EditorChanged()
    {
        var mine = ++edit;
        await Task.Delay(400);
        if (mine != edit) return;

        try
        {
            JsonNode.Parse(styleJson);
            applied = styleJson;
            ok = true;
            status = $"applied at {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception exception)
        {
            ok = false;
            status = "not applied - " + exception.Message.Split('\n')[0].TrimEnd('\r');
        }
    }
}
