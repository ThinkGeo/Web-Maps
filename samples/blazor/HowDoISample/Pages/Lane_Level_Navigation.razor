@page "/lane-level-navigation"
@using ThinkGeo.Core
@using System.Globalization
@using System.Text.Json.Nodes
@implements IDisposable

<div class="map-container" style="background:#101317">
    @* Lane level is closer than the twenty-level ladder goes: four more levels are added to it. *@
    <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter" ZoomScales="@zoomScales"
             BackgroundColor="@(GeoColor.FromHtml("#101317"))"
             Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
             Center="@start" Zoom="19" Pitch="58">
        <OverlaysSetting>
            <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Dark" ApiKey="@GlobalSettings.ThinkGeoApiKey" />
            @if (laneMap != null)
            {
                @* The whole lane map is handed to the browser once and cut into tiles there. *@
                <VectorTileOverlay Id="Lanes" StyleJson="@LaneStyle" FeatureSources="@laneMap.Sources" SourceId="features" PushThreshold="20000" />
                <VectorTileOverlay Id="Vehicle" @ref="vehicleOverlay" Style="@vehicleStyle" FeatureSources="@vehicleSources" SourceId="features" />
            }
        </OverlaysSetting>
    </MapView>

    <div style="position:absolute;top:12px;left:12px;min-width:260px;padding:12px 14px;background:rgba(16,19,23,.88);color:#c9d4d0;font:14px system-ui;border-radius:6px">
        <div style="color:#7ef2d9;font-size:16px;font-weight:600">@street</div>
        <div style="color:white;font-size:26px;font-weight:600;line-height:1.2;margin:4px 0">@instruction</div>
        <div>@next</div>
        <div style="display:flex;justify-content:space-between;margin-top:8px"><span>@speed</span><span>@progress</span></div>
    </div>
    <div style="position:absolute;top:12px;right:12px;padding:10px 12px;background:rgba(16,19,23,.88);color:#c9d4d0;font:13px system-ui;border-radius:6px">
        <div style="color:whitesmoke;font-weight:600;margin-bottom:6px">Camera</div>
        <label style="display:flex;align-items:center;gap:8px">
            Pitch
            <input type="range" min="0" max="60" value="@pitch" @oninput="PitchChanged" style="width:150px" />
            <span style="width:36px">@pitch°</span>
        </label>
        <button class="btn btn-sm btn-light" style="margin-top:8px" @onclick="SwitchView">@(tracking ? "Overview Mode" : "Tracking Mode")</button>
    </div>
    @if (laneMap != null)
    {
        <div style="position:absolute;bottom:12px;left:12px;padding:8px 12px;background:rgba(16,19,23,.88);color:#c9d4d0;font:12px system-ui;border-radius:6px">
            <div style="color:#7ef2d9;font-size:14px;font-weight:600">@laneMap.Title</div>
            <div>@stats</div>
            <div>@laneMap.Attribution</div>
        </div>
    }
</div>

