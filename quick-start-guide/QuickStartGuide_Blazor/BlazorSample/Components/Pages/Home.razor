@page "/"
@rendermode InteractiveServer

<MapView Id="map" MapUnit="GeographyUnit.Meter" Center="@(new PointShape(0, 2000000))" Zoom="2" Width="900" Height="600">
    <OverlaysSetting>
        <ThinkGeoCloudVectorMapsOverlay Id="basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                        ApiKey="SGjwpxF60knqZi3R0A9RRE3GqiuRA1LsnxHMot7rJ58~" />
        <VectorTileOverlay Id="capitals" FeatureSources="@capitals" StyleJson="@capitalsJson" />
    </OverlaysSetting>
</MapView>

@code {
    // Read the shapefile; the overlay cuts it into vector tiles as the browser asks for them.
    // The file is in decimal degrees (EPSG:4326); the map is Web Mercator (EPSG:3857),
    // so the source reprojects as it reads. The key is the tiles' "source-layer" name.
    private readonly GeoCollection<FeatureSource> capitals = new GeoCollection<FeatureSource>
    {
        { "WorldCapitals", new ShapeFileFeatureSource(Path.Combine(AppContext.BaseDirectory, "Data", "WorldCapitals.shp"))
            {
                ProjectionConverter = new ProjectionConverter(4326, 3857)
            }
        }
    };

    // A style document for the capitals: white circles with a black outline.
    private const string capitalsJson = @"{
  ""layers"": [
    { ""type"": ""circle"",
      ""source-layer"": ""WorldCapitals"",
      ""paint"": {
          ""circle-radius"": 4,
          ""circle-color"": ""#FFFFFF"",
          ""circle-stroke-color"": ""#000000"",
          ""circle-stroke-width"": 2 } }
  ]
}";
}
