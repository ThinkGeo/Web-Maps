<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <Content Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <EmbeddedResource Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <None Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ThinkGeo.Cad" Version="15.1.0-beta003" />
    <!-- The Linux libraries of CAD (DWG) and GDAL, for a build on Linux or one published for a Linux runtime. -->
    <PackageReference Include="ThinkGeo.Cad.Dependency.Linux" Version="15.1.0-beta001" Condition="'$(OS)' != 'Windows_NT' or $(RuntimeIdentifier.StartsWith('linux'))" />
    <PackageReference Include="ThinkGeo.Gdal.Dependency.Linux" Version="15.0.0" Condition="'$(OS)' != 'Windows_NT' or $(RuntimeIdentifier.StartsWith('linux'))" />
    <PackageReference Include="ThinkGeo.Core" Version="15.1.0-beta003" />
    <PackageReference Include="ThinkGeo.Gdal" Version="15.1.0-beta003" />
    <PackageReference Include="ThinkGeo.UI.Blazor" Version="15.1.0-beta003" />
    <PackageReference Include="ThinkGeo.FileGeoDatabase" Version="15.1.0-beta003" />
    <PackageReference Include="ThinkGeo.NauticalCharts" Version="15.1.0-beta003" />
    <PackageReference Include="ThinkGeo.PostgreSql" Version="15.1.0-beta003" />
    <PackageReference Include="ThinkGeo.SqlServer" Version="15.1.0-beta003" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Pages\**\*.razor">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\**" Exclude="Data\temp\**;Data\**\*.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PublishRazorSources" AfterTargets="Publish">
    <ItemGroup>
      <RazorSourceFile Include="Pages\**\*.razor" />
    </ItemGroup>
    <Copy SourceFiles="@(RazorSourceFile)" DestinationFolder="$(PublishDir)Pages" SkipUnchangedFiles="true" />
  </Target>

</Project>
