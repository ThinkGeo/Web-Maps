@page "/"
@page "/map-navigation"
@using System.Globalization
@using ThinkGeo.Core

<div class="map-container">
    @* Pan, zoom, rotate and tilt are built into the map - no code drives them. The readout follows
       the view: the centre, in latitude and longitude, updates as the map is moved. *@
    <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
             Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
             Center="@(new PointShape(-8236047, 4975307))" Zoom="15"
             OnCurrentExtentChanged="ExtentChanged">
        <OverlaysSetting>
            <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                            ApiKey="@GlobalSettings.ThinkGeoApiKey" />
        </OverlaysSetting>
    </MapView>

    <div style="position:absolute;top:12px;left:12px;width:240px;padding:11px 13px;background:rgba(255,255,255,.94);font:12.5px system-ui;border-radius:4px;box-shadow:0 1px 4px rgba(0,0,0,.25)">
        <div style="font-weight:600;margin-bottom:6px">Map navigation</div>
        <div style="color:#555">
            Midtown Manhattan. Drag to pan, the wheel to zoom, and right-drag to rotate and tilt -
            every gesture is built into the map.
        </div>
        <div style="margin-top:10px;padding-top:8px;border-top:1px solid #ddd;color:#333">@readout</div>
    </div>
</div>

@code {
    private MapView map;
    private string readout = "";

    private void ExtentChanged(CurrentExtentChangedMapViewEventArgs e)
    {
        var center = e.CurrentExtent.GetCenterPoint();
        var lonLat = ProjectionConverter.Convert(3857, 4326, center);
        readout = string.Format(CultureInfo.InvariantCulture, "Center  lat {0:N4}, lon {1:N4}", lonLat.Y, lonLat.X);
    }
}
