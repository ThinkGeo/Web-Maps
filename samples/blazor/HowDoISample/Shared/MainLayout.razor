@inherits LayoutComponentBase
@inject MenuService MenuService
@inject NavigationManager Navigation

<nav class="navbar bg-dark fixed-top">
    <a class="navbar-brand" href="https://thinkgeo.com/"> </a>
    <span class="navbar-text mr-auto">
        <h4>ThinkGeo Web UI for Blazor Samples</h4>
        <h6>Explore the features of ThinkGeo web mapping UI controls for Blazor</h6>
    </span>
    <button class="navbar-toggler collapsed mr-4" type="button" data-toggle="collapse" onclick="window.howDoI.toggleMenu()"
            aria-controls="navbarToggleExternalContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="fa fa-bars"></span>
    </button>
    <ul class="navbar-nav">
        <li class="nav-item"><a class="download-sample" target="_blank" href="https://gitlab.com/thinkgeo/public/thinkgeo-web-maps/-/tree/master/samples/blazor" id="download-sample">Download Source</a></li>
        |
        <li class="nav-item"><a href="https://thinkgeo.com/gis-ui-web" target="_blank" rel="noopener">ThinkGeo UI Web for Blazor</a></li>
        |
        <li class="nav-item"><a href="https://community.thinkgeo.com/" target="_blank" rel="noopener">Support</a></li>
        |
        <li class="nav-item"><a href="https://wiki.thinkgeo.com/wiki/thinkgeo_web_for_blazor" target="_blank" rel="noopener">Wiki</a></li>
    </ul>
</nav>
<div class="container-fluid">
    <div class="row justify-content-end">
        <div class="sidebar collapse" id="sidebar">
            <NavMenu @rendermode="InteractiveServer" />
        </div>
        <main class="main" id="content">
            @if (currentMenu != null)
            {
                <div id="child-page-title" class="pl-md-0 pl-3">
                    <div>
                        <h1>
                            <span class="title">@currentMenu.Title</span>
                        </h1>
                        <div class="description-wrap"><p class="sample-description" style="padding-right: 132px;">@currentMenu.Description</p></div>
                    </div>
                    <div class="code-button-container">
                        <button id="code-button" href="#" role="button" title="Show the sample's Razor beside it"
                           aria-pressed="false" data-source="@currentMenu?.Source"
                           onclick="event.preventDefault(); window.howDoI.toggleRazor(this)">Code</button>
                    </div>
                </div>
            }
            
            <div id="output" class="" style="--code-width:45%" data-border-style="thin" data-header="true">
                <div id="razor-box" class="code-wrap code-box box" role="region" aria-label="Razor" style="display:none">
                    <pre><code id="razor-source" class="language-csharp"></code></pre>
                </div>
                <div id="splitter" class="splitter" role="separator" aria-orientation="vertical" style="display:none"
                     onpointerdown="window.howDoI.beginSplit(event)"></div>
                <div id="result-box" class="code-box active" role="region" aria-label="Result">@Body</div>
            </div>
        </main>
    </div>
</div>
<div id="loadingImage"><i class="fa fa-spinner fa-spin fa-3x fa-fw"></i></div>

@code {
    private MenuModel currentMenu;

    protected override void OnInitialized()
    {
        var menus = MenuService.GetMenus();
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        currentMenu = menus.FirstOrDefault(menu => menu.Href.Trim('/') == path.Trim('/')) ?? menus.FirstOrDefault();
    }
}
