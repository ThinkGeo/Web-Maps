<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <Content Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <EmbeddedResource Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <None Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ThinkGeo.Core" Version="15.0.0-beta189" />
    <PackageReference Include="ThinkGeo.Gdal" Version="15.0.0-beta189" />
    <PackageReference Include="ThinkGeo.UI.Blazor" Version="15.0.0-beta189" />
    <PackageReference Include="ThinkGeo.FileGeoDatabase" Version="15.0.0-beta189" />
    <PackageReference Include="ThinkGeo.NauticalCharts" Version="15.0.0-beta189" />
    <PackageReference Include="ThinkGeo.PostgreSql" Version="15.0.0-beta189" />
    <PackageReference Include="ThinkGeo.SqlServer" Version="15.0.0-beta189" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Pages\*.razor">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\**" Exclude="Data\temp\**;Data\**\*.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PublishRazorSources" AfterTargets="Publish">
    <ItemGroup>
      <RazorSourceFile Include="Pages\*.razor" />
    </ItemGroup>
    <Copy SourceFiles="@(RazorSourceFile)" DestinationFolder="$(PublishDir)Pages" SkipUnchangedFiles="true" />
  </Target>

</Project>
