@page "/hatch-styles"
@using ThinkGeo.Core
@using System.Text.RegularExpressions

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10777610, 3909120))" Zoom="16">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Parks" Style="@style" FeatureSources="@sources" SourceId="features" />
            </OverlaysSetting>
        </MapView>
    </div>
    <div style="width:420px;display:flex;flex-direction:column;background:#f6f6f4;border-left:1px solid #ccc;font:12px system-ui">
        <div style="padding:8px 8px 4px;font-weight:600">style.json - edit it; the map follows</div>
        <div style="padding:0 8px 6px;color:#555">Every GeoHatchStyle is drawn once by AreaStyle.CreateHatchStyle and added to the style's Images under its own name; fill-pattern picks one by that name. Choose a hatch here or type its name into the editor.</div>
        <div style="padding:0 8px 8px;display:flex;gap:8px;align-items:center">
            <span>Hatch</span>
            <select value="@hatch" @onchange="HatchPicked" style="flex:1;font:12px system-ui">
                @foreach (var name in Hatches)
                {
                    <option value="@name">@name</option>
                }
            </select>
        </div>
        <textarea @bind="styleJson" @bind:event="oninput" @bind:after="EditorChanged" spellcheck="false"
                  style="flex:1;font:11.5px Consolas,monospace;padding:6px;border:0;border-top:1px solid #ccc;resize:none;white-space:pre"></textarea>
        <div style="padding:4px 8px 6px;color:@(ok ? "darkgreen" : "firebrick")">@status</div>
    </div>
</div>

@code {
    private static readonly string[] Hatches = Enum.GetNames(typeof(GeoHatchStyle)).OrderBy(name => name, StringComparer.OrdinalIgnoreCase).ToArray();
    private static readonly Regex Pattern = new Regex("(\"fill-pattern\"\\s*:\\s*\"hatch-)([A-Za-z0-9]+)(\")");

    private const string StyleJson = @"{
  ""layers"": [
    { ""type"": ""fill"",
      ""source-layer"": ""parks"",
      ""paint"": {
          ""fill-pattern"": ""hatch-DiagonalCross"" }
    },

    { ""type"": ""line"",
      ""source-layer"": ""parks"",
      ""paint"": {
          ""line-color"": ""#3F7F45"",
          ""line-width"": 1.5 }
    },

    { ""type"": ""symbol"",
      ""source-layer"": ""parks"",
      ""minzoom"": 15,
      ""layout"": {
          ""text-field"": [""get"", ""NAME""],
          ""text-font"": [""Noto Sans Bold""],
          ""text-size"": 12 },
      ""paint"": {
          ""text-color"": ""#2F5F35"",
          ""text-halo-color"": ""#FFFFFF"",
          ""text-halo-width"": 1.5 }
    }
  ]
}";

    private MapView map;
    private GeoCollection<FeatureSource> sources;
    private MapStyle style;
    private string hatch = "DiagonalCross";
    private string styleJson = StyleJson;
    private string status = "";
    private bool ok = true;
    private int edit;

    protected override void OnInitialized()
    {
        sources = new GeoCollection<FeatureSource>
        {
            { "parks", new ShapeFileFeatureSource("./Data/Shapefile/Parks.shp") { ProjectionConverter = new ProjectionConverter(2276, 3857) } }
        };
        style = Build(StyleJson);
    }

    // The document with one pattern image per hatch: 32 pixels of each, drawn by the classic
    // AreaStyle, which MapLibre then tiles across every park.
    private static MapStyle Build(string json)
    {
        var built = new MapStyle(json);
        foreach (GeoHatchStyle value in Enum.GetValues(typeof(GeoHatchStyle)))
        {
            built.Images.Add("hatch-" + value, AreaStyle.CreateHatchStyle(value, GeoColor.FromHtml("#3F7F45"), GeoColor.FromArgb(110, 180, 224, 182)), 32);
        }
        return built;
    }

    private Task HatchPicked(ChangeEventArgs args)
    {
        hatch = (string)args.Value;
        styleJson = Pattern.Replace(styleJson, match => match.Groups[1].Value + hatch + match.Groups[3].Value);
        return EditorChanged();
    }

    // A document that does not parse changes nothing; the map keeps the last one that did.
    private async Task EditorChanged()
    {
        var mine = ++edit;
        await Task.Delay(400);
        if (mine != edit) return;

        try
        {
            style = Build(styleJson);
            var named = Pattern.Match(styleJson);
            if (named.Success && Hatches.Contains(named.Groups[2].Value)) hatch = named.Groups[2].Value;
            ok = true;
            status = $"applied at {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception exception)
        {
            ok = false;
            status = "not applied - " + exception.Message.Split('\n')[0].TrimEnd('\r');
        }
    }
}
