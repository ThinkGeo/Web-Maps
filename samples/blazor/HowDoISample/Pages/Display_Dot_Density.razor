@page "/display-dot-density"
@rendermode InteractiveServer
@using ThinkGeo.Core
@using System.Text.Json.Nodes
@using System.Globalization
@using System.Collections.ObjectModel
@implements IDisposable

@{
    var initialCenter = new PointShape(-10650000, 4600000);
}

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@initialCenter" Zoom="4">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Dots" StyleJson="@applied" FeatureSources="@sources" SourceId="features" />
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@initialCenter" CenterButtonZoom="4" CenterButtonBearing="0" CenterButtonPitch="0" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@initialCenter" Zoom="4" Bearing="0" Pitch="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
        <div style="position:absolute;left:12px;bottom:12px;padding:8px 10px;background:rgba(30,30,30,.88);color:whitesmoke;border-radius:4px;font:12px system-ui;box-shadow:0 1px 4px rgba(0,0,0,.25)">
            <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#1F78B4"></span> Owner-occupied
            <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#F07814;margin-left:12px"></span> Renter-occupied
            <div style="color:#ddd;margin-top:4px">1 dot = 25,000 housing units (1990 census)</div>
        </div>
    </div>
    <div style="width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;padding:8px;display:flex;flex-direction:column;background:dimgray;color:whitesmoke;font:13px system-ui;min-height:0">
        <div style="font-size:16px;font-weight:600;margin-bottom:6px">Display Dot Density</div>
        <div style="margin-bottom:8px;line-height:1.35">Owner- and renter-occupied housing as dots scattered inside each state. Each dot represents 25,000 units.</div>
        <div style="border-top:1px solid #aaa;padding-top:8px;display:flex;flex-direction:column;flex:1;min-height:0">
            <div style="font-weight:700;margin-bottom:4px">style.json - edit it; the map follows</div>
            <div style="font-size:11px;color:#e5e5e5;margin-bottom:6px;line-height:1.3">The dots are generated once as data; the style controls their colours and size.</div>
            <textarea aria-label="style.json editor" @bind="styleJson" @bind:event="oninput" @bind:after="EditorChanged" spellcheck="false"
                      style="flex:1;min-height:0;width:100%;box-sizing:border-box;resize:none;border:1px solid #aaa;background:#fff;color:#111;padding:7px;font:11.5px/1.35 Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;overflow-x:hidden;overflow-y:auto"></textarea>
            <div role="status" style="padding-top:5px;line-height:1.3;overflow-wrap:anywhere;color:@(ok ? "#baf1ba" : "#ffd0b8")">@status</div>
        </div>
    </div>
</div>

@code {
    private const int UnitsPerDot = 25_000;

    private const string StyleJson = @"{
  ""layers"": [
    { ""type"": ""background"",
      ""paint"": { ""background-color"": ""#DDE8F0"" } },

    { ""type"": ""fill"",
      ""source-layer"": ""USStates_3857"",
      ""paint"": {
          ""fill-color"": ""#FCFCFA"",
          ""fill-outline-color"": ""#787878"" }
    },

    { ""type"": ""circle"",
      ""source-layer"": ""owner"",
      ""paint"": {
          ""circle-radius"": 1.9,
          ""circle-color"": ""#1F78B4"" }
    },

    { ""type"": ""circle"",
      ""source-layer"": ""renter"",
      ""paint"": {
          ""circle-radius"": 1.9,
          ""circle-color"": ""#F07814"" }
    }
  ]
}";

    private MapView map;
    private GeoCollection<FeatureSource> sources;
    private string styleJson = StyleJson;
    private string applied = StyleJson;
    private string status = "";
    private bool ok = true;
    private int edit;
    private bool disposed;

    protected override void OnInitialized()
    {
        var states = new ShapeFileFeatureSource("./Data/Shapefile/USStates_3857.shp");
        states.Open();
        try
        {
            var features = states.GetAllFeatures(new[] { "OWNER_OCC", "RENTER_OCC" });
            sources = new GeoCollection<FeatureSource>
            {
                { "USStates_3857", new ShapeFileFeatureSource("./Data/Shapefile/USStates_3857.shp") },
                { "owner", Scatter(features, "OWNER_OCC", seed: 1) },
                { "renter", Scatter(features, "RENTER_OCC", seed: 2) },
            };
        }
        finally
        {
            states.Close();
        }
    }

    // One dot per 25,000 units, dropped at random inside the state until enough have landed.
    private static FeatureSource Scatter(IEnumerable<Feature> states, string column, int seed)
    {
        var dots = new Collection<Feature>();
        var stateIndex = 0;
        foreach (var state in states)
        {
            stateIndex++;
            if (!(state.GetShape() is AreaBaseShape area) ||
                !state.ColumnValues.TryGetValue(column, out var raw) ||
                !double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var units))
            {
                continue;
            }

            var wanted = (int)Math.Round(units / UnitsPerDot);
            var box = area.GetBoundingBox();
            var random = new Random((seed * 7919) + stateIndex);
            var placed = 0;
            for (var attempts = 0; placed < wanted && attempts < wanted * 60; attempts++)
            {
                var candidate = new PointShape(box.LowerLeftPoint.X + (random.NextDouble() * box.Width), box.LowerLeftPoint.Y + (random.NextDouble() * box.Height));
                if (!area.Contains(candidate)) continue;
                dots.Add(new Feature(candidate));
                placed++;
            }
        }
        return new InMemoryFeatureSource(Array.Empty<FeatureSourceColumn>(), dots);
    }

    // A document that does not parse changes nothing; the map keeps the last one that did.
    private async Task EditorChanged()
    {
        var mine = ++edit;
        await Task.Delay(400);
        if (disposed || mine != edit) return;

        try
        {
            var document = JsonNode.Parse(styleJson);
            if (document?["layers"] is not JsonArray layers || layers.Count == 0)
                throw new FormatException("The style must contain a non-empty layers array.");
            applied = styleJson;
            ok = true;
            status = $"applied at {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception exception)
        {
            ok = false;
            status = "not applied - " + exception.Message.Split('\n')[0].TrimEnd('\r');
        }
    }

    public void Dispose()
    {
        disposed = true;
        edit++;
    }
}
