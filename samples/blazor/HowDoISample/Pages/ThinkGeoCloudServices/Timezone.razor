@page "/timezone"
@rendermode InteractiveServer
@using ThinkGeo.Core
@implements IDisposable

<style>
    #zone { left: -140px; }
    #zone::before { left: 150px; }
    #zone::after { left: 150px; }
</style>

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@InitialCenter" Zoom="InitialZoom" OnClick="@Clicked">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Marks" @ref="marks" StyleJson="@MarksStyle" FeatureSources="@sources" SourceId="marks" />
            </OverlaysSetting>
            <PopupOverlaySetting>
                <PopupOverlay Id="Info">
                    <PopupSetting>
                        <Popup @key="askedAt" Id="zone" Position="@askedAt" OffsetY="-8" AutoPan="true">
                            @if (result != null)
                            {
                                <div style="font:12px system-ui;line-height:1.4;min-width:180px">
                                    <strong>Time Zone: @result.TimeZone</strong><br />
                                    Current Local Time: @result.CurrentLocalTime.ToString("yyyy-MM-dd HH:mm")<br />
                                    Daylight Savings Active: @result.DaylightSavingsActive
                                </div>
                            }
                        </Popup>
                    </PopupSetting>
                </PopupOverlay>
            </PopupOverlaySetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@InitialCenter" CenterButtonZoom="InitialZoom" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
        @if (busy)
        {
            <div role="status" aria-label="Getting time zone information" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:2">
                <div style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px 18px;border-radius:6px;background:rgba(255,255,255,.92);box-shadow:0 1px 6px rgba(0,0,0,.25);color:#303638;font:13px system-ui">
                    <img src="images/sample-loading-spinner.svg" alt="" width="64" height="64" />
                    <span>Getting time zone information...</span>
                </div>
            </div>
        }
        <div style="position:absolute;top:12px;right:12px;width:360px;max-width:calc(100% - 24px);box-sizing:border-box;padding:10px 12px;background:rgba(30,30,30,.85);color:whitesmoke;font:13px system-ui;text-align:left;border-radius:4px;z-index:1">
            <div style="font-size:17px;font-weight:600;line-height:1.25;margin-bottom:8px">Find the Time Zone of a Location</div>
            <div style="font-weight:400;line-height:1.4">Click On The Map To Get Time Zone Information</div>
            <div role="status" style="margin-top:8px;line-height:1.35;overflow-wrap:anywhere;color:@StatusColour">@status</div>
        </div>
    </div>
</div>

@code {
    private static readonly PointShape InitialCenter = new PointShape(-10618080, 4557170);
    private static readonly PointShape InitialSearchPoint = new PointShape(-10779572.80, 3915268.68);
    private const int InitialZoom = 4;
    private const string MarksStyle = @"{
  ""layers"": [
    { ""type"": ""fill"", ""source-layer"": ""zone"",
      ""paint"": { ""fill-color"": ""rgba(147,112,219,0.22)"", ""fill-outline-color"": ""#9370DB"" } },
    { ""type"": ""line"", ""source-layer"": ""zone"",
      ""paint"": { ""line-color"": ""#9370DB"", ""line-width"": 1.5 } },
    { ""type"": ""circle"", ""source-layer"": ""asked"",
      ""paint"": { ""circle-radius"": 6, ""circle-color"": ""#6A3DB8"", ""circle-stroke-color"": ""#FFFFFF"", ""circle-stroke-width"": 2 } }
  ]
}";

    private MapView map;
    private VectorTileOverlay marks;
    private GeoCollection<FeatureSource> sources;
    private readonly InMemoryFeatureSource zone = new InMemoryFeatureSource();
    private readonly InMemoryFeatureSource asked = new InMemoryFeatureSource();
    private TimeZoneCloudClient client;
    private bool busy;
    private bool disposed;
    private bool querySucceeded;
    private string status = "Getting time zone information...";
    private string StatusColour => querySucceeded ? "#ffca28" : "#b7bcc5";
    private PointShape askedAt;
    private CloudTimeZoneResult result;

    protected override void OnInitialized()
    {
        sources = new GeoCollection<FeatureSource> { { "zone", zone }, { "asked", asked } };
        client = new TimeZoneCloudClient(GlobalSettings.ThinkGeoCloudClientId, GlobalSettings.ThinkGeoCloudClientSecret);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AskAsync(InitialSearchPoint);
    }

    public void Dispose()
    {
        disposed = true;
        client?.Dispose();
    }

    private Task Clicked(ClickedMapViewEventArgs args) => busy || disposed ? Task.CompletedTask : AskAsync(new PointShape(args.WorldX, args.WorldY));

    private async Task AskAsync(PointShape point)
    {
        if (busy || disposed) return;
        busy = true;
        querySucceeded = false;
        status = "Getting time zone information...";
        await InvokeAsync(StateHasChanged);
        try
        {
            var answer = await client.GetTimeZoneByCoordinateAsync(point.X, point.Y, 3857);
            if (disposed) return;

            zone.InternalFeatures.Clear();
            if (answer.Shape != null)
            {
                // Cloud returns latitude and longitude; the map uses Spherical Mercator.
                var converter = new ProjectionConverter(4326, 3857);
                converter.Open();
                try
                {
                    zone.InternalFeatures.Add(new Feature(converter.ConvertToExternalProjection(answer.Shape)));
                }
                finally
                {
                    converter.Close();
                }
            }
            asked.InternalFeatures.Clear();
            asked.InternalFeatures.Add(new Feature(point));
            await marks.RedrawAsync();

            askedAt = point;
            result = answer;
            status = $"{answer.TimeZone}, {answer.CountryName}.";
            querySucceeded = true;
        }
        catch (Exception exception)
        {
            if (!disposed) status = exception.Message;
        }
        finally
        {
            busy = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }
}
