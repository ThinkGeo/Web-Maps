@page "/export-map"
@rendermode InteractiveAuto
@using ThinkGeo.Core
@using ThinkGeo.UI.Blazor

<div class="map-container">
    @* The picture is the map's own canvas, read back and handed to the browser to save. The
       drawing buffer is kept so the canvas still holds the frame when the button asks for it;
       what downloads is exactly what is on screen - pan, zoom or tilt first and the file follows. *@
    <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
             Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
             Center="@(new PointShape(-8575000, 4707000))" Zoom="12" Pitch="45">
        <OverlaysSetting>
            @if (style != null)
            {
                <VectorTileOverlay Id="Basemap" Style="@style" />
            }
        </OverlaysSetting>
        <MapToolsSetting>
            <MapTools>
                <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                CenterButtonCenter="@(new PointShape(-8575000, 4707000))" CenterButtonZoom="12" />
            </MapTools>
        </MapToolsSetting>
    </MapView>

    <div style="position:absolute;top:12px;right:12px;width:280px;max-height:calc(100% - 24px);overflow:auto;box-sizing:border-box;padding:10px 12px;background:rgba(30,30,30,.85);color:whitesmoke;font:13px system-ui;border-radius:4px">
        <div style="font-weight:600;margin-bottom:6px">Export the map as an image</div>
        <div style="color:#e5e5e5;line-height:1.4;margin-bottom:9px">
            Move the map to the view you want, then save it. The PNG is the map's own canvas,
            read back at screen resolution.
        </div>
        <button class="btn btn-sm btn-light" @onclick="Download">Download PNG</button>
        <div role="status" style="margin-top:8px;color:#e5e5e5">@status</div>
    </div>
</div>

@code {
    private MapView map;
    private MapStyle style;
    private string status = "";

    protected override void OnInitialized()
    {
        style = new MapStyle(ThinkGeoVectorStyles.Light,
            new ThinkGeoVectorTileSource(GlobalSettings.ThinkGeoApiKey));
    }

    private async Task Download()
    {
        await map.WhenReady;
        await map.ExportImageAsync("thinkgeo-map.png");
        status = $"saved thinkgeo-map.png at {DateTime.Now:HH:mm:ss}";
    }
}
