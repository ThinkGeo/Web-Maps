@page "/projection-cloud-services"
@rendermode InteractiveServer
@using ThinkGeo.Core
@implements IDisposable

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@InitialCenter" Zoom="InitialZoom">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Marks" @ref="marks" StyleJson="@MarksStyle" FeatureSources="@sources" SourceId="projected" />
            </OverlaysSetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@InitialCenter" CenterButtonZoom="InitialZoom" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@InitialCenter" Zoom="InitialZoom" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
        @if (busy)
        {
            <div role="status" aria-label="Projecting features" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:2">
                <div style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px 18px;border-radius:6px;background:rgba(255,255,255,.92);box-shadow:0 1px 6px rgba(0,0,0,.25);color:#303638;font:13px system-ui">
                    <img src="images/sample-loading-spinner.svg" alt="" width="64" height="64" />
                    <span>Projecting features...</span>
                </div>
            </div>
        }
    </div>
    <div style="width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;background:dimgray;color:whitesmoke;font:13px system-ui;display:flex;flex-direction:column;min-height:0">
        <div style="padding:8px 8px 4px;font-size:16px;font-weight:600">Using Cloud Projection Services</div>
        <div style="padding:0 8px 4px;line-height:1.35">Enter WKT in latitude and longitude (EPSG:4326), then project it to the map's Web Mercator coordinates (EPSG:3857).</div>
        <textarea @bind="wkt" spellcheck="false" aria-label="WKT input"
                  style="width:100%;min-height:150px;box-sizing:border-box;background:#fff;color:#222;font:11.5px Consolas,monospace;padding:6px;border:0;border-top:1px solid #ccc;resize:vertical;white-space:pre-wrap;overflow-wrap:anywhere"></textarea>
        <div style="padding:6px 8px 0">
            <button style="width:100%;@SidebarButtonStyle" @onclick="ProjectPointAsync" disabled="@busy">Reproject and Display a Feature</button>
            <button style="width:100%;margin-top:6px;@SidebarButtonStyle" @onclick="ProjectAsync" disabled="@busy">Reproject and Display Multiple Features</button>
        </div>
        <div role="status" style="padding:5px 8px;min-height:18px;line-height:1.3;color:@StatusColour">@status</div>
        <textarea readonly spellcheck="false" aria-label="Projected WKT output"
                  style="flex:1;min-height:120px;width:100%;box-sizing:border-box;background:#696969;color:#fff;font:11.5px Consolas,monospace;padding:6px;border:0;border-top:1px solid #ccc;resize:none;white-space:pre-wrap;overflow-wrap:anywhere">@projectedWkt</textarea>
    </div>
</div>

@code {
    private const string SidebarButtonStyle = "border:2px solid #8a8a8a;background:#f6f6f4;color:#222;padding:2px 4px;cursor:pointer;font:13px system-ui";
    private static readonly PointShape InitialCenter = new PointShape(-10778720, 3915154);
    private const int InitialZoom = 13;
    private const string MarksStyle = @"{
  ""layers"": [
    { ""type"": ""fill"", ""source-layer"": ""projected"",
      ""paint"": { ""fill-color"": ""rgba(147,112,219,0.3)"", ""fill-outline-color"": ""#9370DB"" } },
    { ""type"": ""line"", ""source-layer"": ""projected"",
      ""paint"": { ""line-color"": ""#9370DB"", ""line-width"": 4 } },
    { ""type"": ""circle"", ""source-layer"": ""projected"", ""filter"": [""=="", [""geometry-type""], ""Point""],
      ""paint"": { ""circle-radius"": 8, ""circle-color"": ""#9370DB"", ""circle-stroke-color"": ""#FFFFFF"", ""circle-stroke-width"": 2 } }
  ]
}";

    private MapView map;
    private VectorTileOverlay marks;
    private GeoCollection<FeatureSource> sources;
    private readonly InMemoryFeatureSource projected = new InMemoryFeatureSource();
    private ProjectionCloudClient client;
    private bool busy;
    private bool disposed;
    private string status = "";
    private string projectedWkt = "";
    private string StatusColour => status.StartsWith("Not", StringComparison.Ordinal) || status.StartsWith("Projection failed", StringComparison.Ordinal) ? "#ffd0d0" : "#c9f5d2";
    private string wkt = string.Join("\n",
        "POINT(-96.834516 33.150083)",
        "LINESTRING(-96.8425 33.1465,-96.8380 33.1502,-96.8322 33.1518,-96.8271 33.1560)",
        "POLYGON((-96.8460 33.1400,-96.8380 33.1400,-96.8380 33.1440,-96.8460 33.1440,-96.8460 33.1400))");

    protected override void OnInitialized()
    {
        sources = new GeoCollection<FeatureSource> { { "projected", projected } };
        client = new ProjectionCloudClient(GlobalSettings.ThinkGeoCloudClientId, GlobalSettings.ThinkGeoCloudClientSecret);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ProjectAsync();
    }

    public void Dispose()
    {
        disposed = true;
        client?.Dispose();
    }

    private Task ProjectPointAsync() => ProjectFeaturesAsync(new[] { new Feature("POINT(-96.834516 33.150083)") });

    private async Task ProjectAsync()
    {
        var features = new List<Feature>();
        foreach (var line in wkt.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
        {
            try { features.Add(new Feature(line.Trim())); }
            catch (Exception exception)
            {
                status = "Not well known text: " + line.Trim() + " (" + exception.Message + ")";
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        if (features.Count == 0)
        {
            status = "Enter at least one WKT feature.";
            return;
        }
        await ProjectFeaturesAsync(features);
    }

    private async Task ProjectFeaturesAsync(IEnumerable<Feature> features)
    {
        if (busy || disposed) return;
        busy = true;
        status = "Projecting features...";
        projectedWkt = "";
        await InvokeAsync(StateHasChanged);
        try
        {
            var results = await client.ProjectAsync(new System.Collections.ObjectModel.Collection<Feature>(features.ToList()), 4326, 3857);
            if (disposed) return;
            projected.InternalFeatures.Clear();
            foreach (var feature in results) projected.InternalFeatures.Add(feature);
            projectedWkt = string.Join("\n", results.Select(feature => feature.GetWellKnownText()));
            status = $"{results.Count} shapes projected.";
            await marks.RedrawAsync();
            var bounds = MapUtil.GetBoundingBoxOfItems(results.Select(feature => feature.GetShape()));
            bounds.ScaleUp(40);
            await map.ZoomToExtentAsync(bounds);
        }
        catch (Exception exception)
        {
            if (!disposed) status = "Projection failed: " + exception.Message;
        }
        finally
        {
            busy = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }
}
