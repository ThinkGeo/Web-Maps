@page "/get-data-from-one-feature"
@rendermode InteractiveServer
@using ThinkGeo.Core
@using System.Text.Json.Nodes
@implements IDisposable

@{
    var initialCenter = new PointShape(-10778100, 3915600);
}

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@initialCenter" Zoom="13" Bearing="0" Pitch="0" OnClick="@MapClicked">
            <OverlaysSetting>
                <ThinkGeoCloudVectorMapsOverlay Id="Basemap" MapType="ThinkGeoCloudVectorMapsMapType.Light"
                                                ApiKey="@GlobalSettings.ThinkGeoApiKey" />
                <VectorTileOverlay Id="Parks" StyleJson="@applied" FeatureSources="@sources" SourceId="features" />
            </OverlaysSetting>
            <PopupOverlaySetting>
                <PopupOverlay Id="Info" PopupSource="@picked">
                    <PopupSetting Context="park">
                        <Popup Id="park-info" Position="@(((Feature)park).GetShape().GetCenterPoint())">
                            <div style="font:11px Verdana,sans-serif;white-space:pre;max-height:260px;overflow:auto">@Describe((Feature)park)</div>
                        </Popup>
                    </PopupSetting>
                </PopupOverlay>
            </PopupOverlaySetting>
            <MapToolsSetting>
                <MapTools>
                    <ZoomBarMapTool Location="ZoomBarLocation.UpperLeft" UseNavigationStyle="true"
                                    CenterButtonCenter="@initialCenter" CenterButtonZoom="13" CenterButtonBearing="0" CenterButtonPitch="0" />
                    <CompassMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="10" />
                    <HomeMapTool Location="ZoomBarLocation.UpperRight" OffsetX="10" OffsetY="60"
                                 Center="@initialCenter" Zoom="13" Bearing="0" Pitch="0" />
                </MapTools>
            </MapToolsSetting>
        </MapView>
        @if (busy)
        {
            <div role="status" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);padding:10px 16px;border-radius:6px;background:rgba(30,30,30,.85);color:white;font:13px system-ui;pointer-events:none;z-index:2">Reading feature data...</div>
        }
    </div>
    <div style="width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;padding:8px;background:dimgray;color:whitesmoke;font:13px system-ui;display:flex;flex-direction:column;min-height:0">
        <div style="font-size:16px;font-weight:600;margin-bottom:6px">Get Data from One Feature</div>
        <div style="color:#e5e5e5;font-size:11px;line-height:1.35;margin-bottom:8px">Click a park to read every column in its record.</div>
        <div style="font-weight:700;border-bottom:1px solid #aaa;padding-bottom:5px">@selectionTitle</div>
        <pre role="status" style="flex:1;min-height:80px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;margin:6px 0 10px;padding:7px;background:#4b4b4b;color:#f2f2f2;font:11px/1.45 Consolas,monospace">@selectedInfo</pre>
        <div style="border-top:1px solid #aaa;padding-top:8px;display:flex;flex-direction:column;min-height:150px;flex:1">
            <div style="font-weight:700;margin-bottom:4px">style.json - edit it; the map follows</div>
            <textarea aria-label="style.json editor" @bind="styleJson" @bind:event="oninput" @bind:after="EditorChanged" spellcheck="false" wrap="soft"
                      style="flex:1;min-height:0;width:100%;box-sizing:border-box;background:#fff;color:#222;font:11.5px Consolas,monospace;padding:7px;border:1px solid #aaa;resize:none;white-space:pre-wrap;overflow-wrap:anywhere;overflow-x:hidden;overflow-y:auto"></textarea>
            <div role="status" style="padding-top:5px;line-height:1.3;overflow-wrap:anywhere;color:@(ok ? "#c9f5d2" : "#ffd0d0")">@status</div>
        </div>
    </div>
</div>

@code {
    private const string StyleJson = @"{
  ""layers"": [
    { ""type"": ""fill"",
      ""source-layer"": ""parks"",
      ""paint"": {
          ""fill-color"": ""rgba(147,112,219,0.2)"",
          ""fill-outline-color"": ""#9370DB"" }
    }
  ]
}";

    private MapView map;
    private GeoCollection<FeatureSource> sources;
    private ShapeFileFeatureSource parks;
    private readonly List<Feature> picked = new List<Feature>();
    private string styleJson = StyleJson;
    private string applied = StyleJson;
    private string status = "";
    private bool ok = true;
    private bool busy;
    private bool disposed;
    private string selectionTitle = "Feature attributes";
    private string selectedInfo = "No park selected. Click a park on the map to inspect its attributes.";
    private int edit;

    protected override void OnInitialized()
    {
        sources = new GeoCollection<FeatureSource>
        {
            { "parks", new ShapeFileFeatureSource("./Data/Shapefile/Parks.shp") { ProjectionConverter = new ProjectionConverter(2276, 3857) } }
        };
        parks = new ShapeFileFeatureSource("./Data/Shapefile/Parks.shp") { ProjectionConverter = new ProjectionConverter(2276, 3857) };
    }

    private async Task MapClicked(ClickedMapViewEventArgs args)
    {
        if (busy || disposed) return;
        busy = true;
        await InvokeAsync(StateHasChanged);
        parks.Open();
        try
        {
            var park = new QueryTools(parks).GetFeaturesContaining(new PointShape(args.WorldX, args.WorldY), ReturningColumnsType.AllColumns).FirstOrDefault();
            picked.Clear();
            if (park != null)
            {
                picked.Add(park);
                selectionTitle = "Selected park attributes";
                selectedInfo = Describe(park);
            }
            else
            {
                selectionTitle = "No park at this location";
                selectedInfo = "Click inside a shaded park area to read its feature data.";
            }
        }
        finally
        {
            parks.Close();
            busy = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private static string Describe(Feature feature)
        => string.Join("\n", feature.ColumnValues.Select(column => column.Key + ": " + column.Value));

    // A document that does not parse changes nothing; the map keeps the last one that did.
    private async Task EditorChanged()
    {
        var mine = ++edit;
        await Task.Delay(400);
        if (mine != edit || disposed) return;

        try
        {
            if (JsonNode.Parse(styleJson) is not JsonObject document || document["layers"] is not JsonArray)
                throw new FormatException("The style needs a layers array.");
            applied = styleJson;
            ok = true;
            status = $"applied at {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception exception)
        {
            ok = false;
            status = "not applied - " + exception.Message.Split('\n')[0].TrimEnd('\r');
        }
    }

    public void Dispose()
    {
        disposed = true;
        edit++;
    }
}
