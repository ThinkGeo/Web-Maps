<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <Content Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <EmbeddedResource Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
    <None Remove="ThinkGeo.UI.Blazor.HowDoI\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ThinkGeo.Core" Version="15.0.0-beta181" />
    <PackageReference Include="ThinkGeo.Gdal" Version="15.0.0-beta181" />
    <PackageReference Include="ThinkGeo.UI.Blazor" Version="15.0.0-beta181" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Pages\*.razor">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
