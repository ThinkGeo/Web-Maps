@page "/dynamic-rendering"
@rendermode InteractiveServer
@using ThinkGeo.Core
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions
@using System.Globalization
@using System.Collections.ObjectModel
@implements IDisposable

<div class="map-container" style="display:flex">
    <div style="flex:1;min-width:0;position:relative">
        <MapView Id="map" @ref="map" MapUnit="GeographyUnit.Meter"
                 Width="100" Height="100" MapViewSizeUnitType="MapViewSizeUnitType.Percentage"
                 Center="@(new PointShape(-10650000, 4770000))" Zoom="4">
            <OverlaysSetting>
                <VectorTileOverlay Id="States" StyleJson="@StatesStyleJson" FeatureSources="@states" SourceId="states" />
                <VectorTileOverlay Id="Circles" StyleJson="@applied" FeatureSources="@circles" SourceId="circles" />
            </OverlaysSetting>
        </MapView>
        <div style="position:absolute;left:14px;top:10px;font:bold 44px system-ui;color:rgba(40,40,40,.75);pointer-events:none">@year</div>
    </div>
    <div style="width:270px;flex:0 0 270px;box-sizing:border-box;margin-left:10px;padding:8px;display:flex;flex-direction:column;background:dimgray;color:whitesmoke;font:13px system-ui;min-height:0">
        <div style="font-size:16px;font-weight:600;margin-bottom:6px">Dynamic Rendering</div>
        <div style="margin-bottom:8px;line-height:1.35">Edit the style JSON to change the population circles. The map follows the valid style while the year slider and animation select a different population column.</div>
        <div style="border-top:1px solid #aaa;padding-top:8px;display:flex;flex-direction:column;flex:1;min-height:0">
        <div style="font-weight:700;margin-bottom:4px">style.json - edit it; the map follows</div>
        <div style="font-size:11px;color:#e5e5e5;margin-bottom:6px;line-height:1.3">One circle per state, with population columns from @FirstYear to @LastYear.</div>
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:6px">
            <button class="btn btn-sm btn-light" style="width:64px" @onclick="TogglePlay">@(playing ? "Stop" : "Play")</button>
            <input aria-label="Year" type="range" min="@FirstYear" max="@LastYear" step="1" value="@year" @oninput="YearDragged" style="flex:1" />
        </div>
        <textarea aria-label="style.json editor" @bind="styleJson" @bind:event="oninput" @bind:after="EditorChanged" spellcheck="false"
                  style="flex:1;min-height:0;width:100%;box-sizing:border-box;resize:none;border:1px solid #aaa;background:#fff;color:#111;padding:7px;font:11.5px/1.35 Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;overflow-x:hidden;overflow-y:auto"></textarea>
        <div role="status" style="padding-top:5px;line-height:1.3;overflow-wrap:anywhere;color:@(ok ? "#baf1ba" : "#ffd0b8")">@status</div>
        </div>
    </div>
</div>

@code {
    private const int FirstYear = 1900;
    private const int LastYear = 2024;
    private static readonly Regex YearColumn = new Regex("\"y\\d{4}\"");

    private const string StatesStyleJson = @"{
  ""layers"": [
    { ""type"": ""background"", ""paint"": { ""background-color"": ""#FFFFFF"" } },
    { ""type"": ""fill"", ""source-layer"": ""states"",
      ""paint"": { ""fill-color"": ""#F8F8F8"", ""fill-outline-color"": ""#B0B0B0"" } }
  ]
}";

    private const string StyleJson = @"{
  ""layers"": [
    { ""type"": ""circle"",
      ""source-layer"": ""population"",
      ""paint"": {
          ""circle-radius"": [""interpolate"", [""linear""], [""sqrt"", [""to-number"", [""get"", ""y1950""]]],
              0, 2,
              6300, 42],
          ""circle-color"": [""interpolate"", [""linear""], [""to-number"", [""get"", ""y1950""]],
              0, ""#2C7BB6"",
              5000000, ""#FFFFBF"",
              20000000, ""#D7191C""],
          ""circle-opacity"": 0.65,
          ""circle-stroke-color"": ""#FFFFFF"",
          ""circle-stroke-width"": 1 }
    },

    { ""type"": ""symbol"",
      ""source-layer"": ""population"",
      ""layout"": {
          ""text-field"": [""get"", ""STATE_ABBR""],
          ""text-font"": [""Noto Sans Bold""],
          ""text-size"": 10,
          ""text-allow-overlap"": true },
      ""paint"": { ""text-color"": ""#333333"" }
    }
  ]
}";

    private MapView map;
    private GeoCollection<FeatureSource> states;
    private GeoCollection<FeatureSource> circles;
    private int year = 1950;
    private bool playing;
    private CancellationTokenSource player;
    private bool disposed;
    private string styleJson = StyleJson;
    private string applied = StyleJson;
    private string status = "";
    private bool ok = true;
    private int edit;

    protected override void OnInitialized()
    {
        states = new GeoCollection<FeatureSource> { { "states", new ShapeFileFeatureSource("./Data/Shapefile/USStates_3857.shp") } };
        circles = new GeoCollection<FeatureSource> { { "population", Population() } };
    }

    // A point at the middle of each state, with one column per year of population.
    private static FeatureSource Population()
    {
        var byStateAndYear = new Dictionary<(string, int), string>();
        foreach (var line in File.ReadLines("./Data/Csv/historical_state_population_by_year.csv"))
        {
            var parts = line.Split(',');
            if (parts.Length == 3 && int.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out var y)) byStateAndYear[(parts[0], y)] = parts[2];
        }

        var columns = new Collection<FeatureSourceColumn> { new FeatureSourceColumn("STATE_ABBR", "String", 2) };
        for (var y = FirstYear; y <= LastYear; y++)
        {
            columns.Add(new FeatureSourceColumn("y" + y, "Integer", 12));
        }

        var shapefile = new ShapeFileFeatureSource("./Data/Shapefile/USStates_3857.shp");
        shapefile.Open();
        var features = new Collection<Feature>();
        foreach (var state in shapefile.GetAllFeatures(new[] { "STATE_ABBR" }))
        {
            var abbreviation = state.ColumnValues["STATE_ABBR"];
            var values = new Dictionary<string, string> { ["STATE_ABBR"] = abbreviation };
            for (var y = FirstYear; y <= LastYear; y++)
            {
                values["y" + y] = byStateAndYear.TryGetValue((abbreviation, y), out var population) ? population : "0";
            }
            features.Add(new Feature(state.GetShape().GetCenterPoint(), values));
        }
        shapefile.Close();

        return new InMemoryFeatureSource(columns, features);
    }

    private Task YearDragged(ChangeEventArgs args)
    {
        year = int.Parse((string)args.Value, CultureInfo.InvariantCulture);
        return ShowYear();
    }

    // Every "yNNNN" in the document becomes the chosen year; the editor shows the same text
    // the map draws.
    private Task ShowYear()
    {
        styleJson = YearColumn.Replace(styleJson, "\"y" + year + "\"");
        return Apply(0);
    }

    private async Task TogglePlay()
    {
        if (disposed) return;
        if (playing)
        {
            player.Cancel();
            return;
        }

        playing = true;
        var playback = new CancellationTokenSource();
        player = playback;
        var token = playback.Token;
        try
        {
            if (year >= LastYear) year = FirstYear;
            using var ticks = new PeriodicTimer(TimeSpan.FromMilliseconds(120));
            while (year < LastYear && await ticks.WaitForNextTickAsync(token))
            {
                year++;
                await ShowYear();
                if (!disposed) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (ReferenceEquals(player, playback))
            {
                playing = false;
                player = null;
            }
            playback.Dispose();
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private Task EditorChanged() => Apply(400);

    // A document that does not parse changes nothing; the map keeps the last one that did.
    private async Task Apply(int delay)
    {
        var mine = ++edit;
        if (delay > 0) await Task.Delay(delay);
        if (mine != edit) return;

        try
        {
            JsonNode.Parse(styleJson);
            applied = styleJson;
            ok = true;
            status = $"applied at {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception exception)
        {
            ok = false;
            status = "not applied - " + exception.Message.Split('\n')[0].TrimEnd('\r');
        }
    }

    public void Dispose()
    {
        disposed = true;
        player?.Cancel();
    }
}
